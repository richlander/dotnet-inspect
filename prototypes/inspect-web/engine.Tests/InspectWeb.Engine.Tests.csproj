<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\engine.Core\InspectWeb.Engine.Core.csproj" />
    <ProjectReference Include="..\engine\InspectWeb.Engine.csproj" />
    <ProjectReference Include="..\..\..\fixtures\inspect-web\InspectWeb.CloneTransportFixtures\InspectWeb.CloneTransportFixtures.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\..\fixtures\queries\DotnetInspector.CloneSearchFixtures\DotnetInspector.CloneSearchFixtures.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\..\fixtures\inspect-web\InspectWeb.MethodBodyFixtures\InspectWeb.MethodBodyFixtures.csproj" />
    <ProjectReference Include="..\..\..\fixtures\analysis\ILInspector.Analysis.Fixtures\ILInspector.Analysis.Fixtures.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!--
      Both Source comparison fixtures publish the same InspectWebSourceComparisonFixture.dll file
      name, so they are build-ordering references only; the tests read them through FixtureCatalog.
    -->
    <ProjectReference Include="..\..\..\fixtures\inspect-web\InspectWeb.SourceComparisonFixtures.V1\InspectWeb.SourceComparisonFixtures.V1.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\fixtures\inspect-web\InspectWeb.SourceComparisonFixtures.V2\InspectWeb.SourceComparisonFixtures.V2.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\fixtures\presentation\LibraryApiDiff.V1\LibraryApiDiff.V1.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\fixtures\presentation\LibraryApiDiff.V2\LibraryApiDiff.V2.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\tests\DotnetInspector.FixtureInfrastructure\DotnetInspector.FixtureInfrastructure.csproj" />
  </ItemGroup>
</Project>
