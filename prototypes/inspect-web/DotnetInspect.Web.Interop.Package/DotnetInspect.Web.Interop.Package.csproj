<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>DotnetInspect.Web.Interop.Package</AssemblyName>
    <RootNamespace>DotnetInspect.Web.Interop.Package</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotnetInspect.Web.Tests" />
    <!--
      Every browser interaction that inspects an assembly runs inside a workspace, through a
      public product query that owns the session. BannedSymbols.txt makes the compiler enforce
      that for every export assembly; BrowserEngineLayeringTests pins this wiring.
    -->
    <AdditionalFiles Include="..\DotnetInspect.Web\BannedSymbols.txt" />
    <ProjectReference Include="..\DotnetInspect.Web.Core\DotnetInspect.Web.Core.csproj" />
    <ProjectReference Include="..\..\..\src\CSharpText\CSharpText.csproj" />
    <ProjectReference Include="..\..\..\src\DotnetInspector.PackageQueries\DotnetInspector.PackageQueries.csproj" />
    <ProjectReference Include="..\..\..\src\DotnetInspector.Packages\DotnetInspector.Packages.csproj" />
    <ProjectReference Include="..\..\..\src\DotnetInspector.Queries\DotnetInspector.Queries.csproj" />
    <ProjectReference Include="..\..\..\src\ILInspector.Metadata\ILInspector.Metadata.csproj" />
  </ItemGroup>
</Project>
