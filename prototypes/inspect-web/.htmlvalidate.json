{
  "extends": ["html-validate:recommended"],
  "elements": ["html5", "./html-elements.json"],
  "rules": {
    "doctype-style": "off",
    "void-style": "off",
    "long-title": "off",
    "attr-pattern": ["error", { "pattern": "^(?!on[a-z])[a-zA-Z0-9:_.-]+$" }],
    "require-sri": ["error", { "target": "crossorigin" }],
    "allowed-links": ["error", {
      "allowExternal": { "include": ["^https://cdn\\.jsdelivr\\.net/"] }
    }]
  }
}
