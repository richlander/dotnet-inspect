<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPublishable>true</IsPublishable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <WasmEnableExceptionHandling>false</WasmEnableExceptionHandling>
    <RepositoryUrl>https://github.com/richlander/dotnet-inspect</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IsInspectionProductProject>true</IsInspectionProductProject>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepositoryCommit" Value="$(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
    <AssemblyMetadata Include="BuildTimestampUtc" Value="$(BuildTimestampUtc)" Condition="'$(BuildTimestampUtc)' != ''" />
    <InternalsVisibleTo Include="InspectWeb.Engine.Tests" />
    <!--
      Every browser interaction that inspects an assembly runs inside a workspace, through a public
      product query that owns the session. BannedSymbols.txt makes the compiler enforce that;
      Directory.Build.targets already escalates RS0030 to an error for every .csproj.
      BrowserEngineLayeringTests pins this wiring.
    -->
    <AdditionalFiles Include="BannedSymbols.txt" />
    <ProjectReference Include="..\engine.Core\InspectWeb.Engine.Core.csproj" />
    <ProjectReference Include="..\..\..\src\DotnetInspector.PackageQueries\DotnetInspector.PackageQueries.csproj" />
    <ProjectReference Include="..\..\..\src\DotnetInspector.Packages\DotnetInspector.Packages.csproj" />
    <ProjectReference Include="..\..\..\src\DotnetInspector.Queries\DotnetInspector.Queries.csproj" />
    <ProjectReference Include="..\..\..\src\DotnetInspector.ResearchQueries\DotnetInspector.ResearchQueries.csproj" />
    <ProjectReference Include="..\..\..\src\DotnetInspector.Services\DotnetInspector.Services.csproj" />
    <ProjectReference Include="..\..\..\src\DotnetInspector.Vocabulary\DotnetInspector.Vocabulary.csproj" />
    <ProjectReference Include="..\..\..\src\CSharpText\CSharpText.csproj" />
    <ProjectReference Include="..\..\..\src\ILInspector.Metadata\ILInspector.Metadata.csproj" />
    <ProjectReference Include="..\..\..\src\DotnetInspector.CSharpBodySlicer\DotnetInspector.CSharpBodySlicer.csproj" />
    <ProjectReference Include="..\..\..\src\ILInspector.Decompiler\ILInspector.Decompiler.csproj" />
    <ProjectReference Include="..\..\..\src\ILInspector.Analysis\ILInspector.Analysis.csproj" />
    <ProjectReference Include="..\..\..\src\ILInspector.CallGraph\ILInspector.CallGraph.csproj" />
    <ProjectReference Include="..\..\..\src\ILInspector.Research\ILInspector.Research.csproj" />
    <ProjectReference Include="..\..\..\src\ILInspector.SourceLink\ILInspector.SourceLink.csproj" />
    <Content Include="..\dist\index.html" Link="wwwroot\index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Include="..\dist\manifest.json" Link="wwwroot\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\dist\assets\**\*" Link="wwwroot\assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\staticwebapp.config.json" Link="wwwroot\staticwebapp.config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\assets\dotnet-inspect-bot.png" Link="wwwroot\assets\dotnet-inspect-bot.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\assets\bots\*.png" Link="wwwroot\assets\bots\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\assets\platform-index.tsv" Link="wwwroot\assets\platform-index.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateInspectWebFrontendBundle" BeforeTargets="ResolveProjectStaticWebAssets;PrepareForPublish">
    <Error Condition="!Exists('..\dist\index.html') Or !Exists('..\dist\manifest.json')" Text="The inspect-web frontend bundle is missing. Run 'npm ci' and 'npm run build' in prototypes/inspect-web before building or publishing." />
    <Exec Command="node &quot;../scripts/verify-site-artifact.ts&quot; &quot;../dist&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="PublishInspectWebFrontendIndex" AfterTargets="ComputeAndCopyFilesToPublishDirectory">
    <Error Condition="'@(_HtmlPublishCandidates)' == ''" Text="The .NET SDK did not produce the inspect-web HTML placeholder artifact." />
    <Copy SourceFiles="@(_HtmlPublishCandidates)" DestinationFiles="@(_HtmlPublishCandidates->'$(PublishDir)wwwroot/index.html')" />
  </Target>

  <Target Name="VerifyPublishedInspectWebSite" AfterTargets="PublishInspectWebFrontendIndex">
    <Exec Command="node &quot;../scripts/verify-site-artifact.ts&quot; &quot;$(PublishDir)wwwroot&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
