<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <AssemblyName>DependencyPolicy</AssemblyName>
    <RootNamespace>DependencyPolicy</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DependencyPolicy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ILInspector.Metadata/ILInspector.Metadata.csproj" />
  </ItemGroup>

</Project>
