{
  "schemaVersion": 1,
  "solution": "dotnet-inspect.slnx",
  "configuration": "Release",
  "rules": [
    {
      "id": "dependency-free-contract-floors",
      "source": "docs/overview.md, docs/design/inspection-layers.md, and docs/design/ts-jsexport.md",
      "graphs": [
        "project",
        "assembly"
      ],
      "targets": [
        "CSharpText",
        "Inspector.Artifacts",
        "DotnetInspector.RowSelection",
        "Inspector.Findings",
        "ILInspector.MetadataPrimitives",
        "InertText",
        "TsJsExport.Contracts"
      ],
      "allowOnly": [
        "$platform"
      ]
    },
    {
      "id": "engine-libraries-stay-below-tool-libraries",
      "source": "docs/design/inspection-layers.md#seam-rules",
      "graphs": [
        "project",
        "assembly"
      ],
      "targets": [
        "CSharpText",
        "ILInspector.*",
        "InertText"
      ],
      "projectPaths": [
        "src/*/*.csproj"
      ],
      "excludeTargets": [
        "*.App",
        "*.Tests",
        "*Fixture*",
        "ILInspector.Analysis.CallerGraph*"
      ],
      "deny": [
        "DotnetInspector.*"
      ]
    },
    {
      "id": "ecosystem-catalog-stays-in-approved-hosts",
      "source": "docs/design/ecosystem-packs.md#dependency-boundary",
      "graphs": [
        "project",
        "assembly"
      ],
      "targets": [
        "*"
      ],
      "projectPaths": [
        "src/*/*.csproj"
      ],
      "excludeTargets": [
        "*.Tests",
        "*Fixture*",
        "dotnet-inspect",
        "DotnetInspect.Cli"
      ],
      "deny": [
        "DotnetInspector.Ecosystems"
      ]
    },
    {
      "id": "product-libraries-use-repository-and-platform-assemblies",
      "source": "docs/dependency-policy.md#external-dependencies",
      "graphs": [
        "assembly"
      ],
      "targets": [
        "CSharpText",
        "DotnetInspector.*",
        "ILInspector.*",
        "Inspector.*",
        "InertText",
        "TsJsExport.Contracts"
      ],
      "projectPaths": [
        "src/*/*.csproj"
      ],
      "excludeTargets": [
        "*.App",
        "*.Tests",
        "*Fixture*",
        "ILInspector.Analysis.CallerGraph*",
        "DotnetInspector.MetadataRendering",
        "DotnetInspector.Packages",
        "DotnetInspector.Presentation",
        "DotnetInspector.Queries",
        "DotnetInspector.Services"
      ],
      "allowOnly": [
        "$platform",
        "$repository"
      ]
    },
    {
      "id": "metadata-rendering-external-dependencies",
      "source": "docs/design/inspection-layers.md#seam-rules",
      "graphs": [
        "assembly"
      ],
      "targets": [
        "DotnetInspector.MetadataRendering"
      ],
      "allowOnly": [
        "$platform",
        "$repository",
        "Markout"
      ]
    },
    {
      "id": "presentation-external-dependencies",
      "source": "docs/architecture.md#query-and-current-lens-composition",
      "graphs": [
        "assembly"
      ],
      "targets": [
        "DotnetInspector.Presentation"
      ],
      "allowOnly": [
        "$platform",
        "$repository",
        "Markout"
      ]
    },
    {
      "id": "presentation-stays-host-neutral",
      "source": "docs/design/member-source-diff-presentation.md#result-and-host-boundary",
      "graphs": [
        "project",
        "assembly"
      ],
      "targets": [
        "DotnetInspector.Presentation"
      ],
      "deny": [
        "dotnet-inspect"
      ]
    },
    {
      "id": "package-library-external-dependencies",
      "source": "docs/overview.md",
      "graphs": [
        "assembly"
      ],
      "targets": [
        "DotnetInspector.Packages"
      ],
      "allowOnly": [
        "$platform",
        "$repository",
        "NuGet.Versioning",
        "System.Security.Cryptography.ProtectedData"
      ]
    },
    {
      "id": "query-library-external-dependencies",
      "source": "docs/design/inspection-layers.md#l1--dotnetinspectorqueries",
      "graphs": [
        "assembly"
      ],
      "targets": [
        "DotnetInspector.Queries"
      ],
      "allowOnly": [
        "$platform",
        "$repository",
        "NuGet.Frameworks",
        "NuGet.Versioning"
