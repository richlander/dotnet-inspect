<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>

    <!-- A separate shipping tool with its own entry point and its own
         diagnostics, outside the CLI's reference closure and outside the
         stderr-ownership rule (#3319). -->
    <OwnsItsOwnStderr>true</OwnsItsOwnStderr>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Richard Lander</Authors>
    <!-- Opts back in to the repo-wide IsPackable=false default (#3330). -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>runfaster</ToolCommandName>
    <VersionPrefix>0.1.0</VersionPrefix>
    <PackageId>runfaster</PackageId>
    <Description>CLI for correlating dotnet-* runtime diagnostics with static .NET library allocation candidates</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="runfaster.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetInspector.Core\DotnetInspector.Core.csproj" />
    <ProjectReference Include="..\DotnetInspector.Packages\DotnetInspector.Packages.csproj" />
    <ProjectReference Include="..\DotnetInspector.Services\DotnetInspector.Services.csproj" />
    <ProjectReference Include="..\ILInspector.Analysis\ILInspector.Analysis.csproj" />
    <ProjectReference Include="..\ILInspector.Metadata\ILInspector.Metadata.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

</Project>
