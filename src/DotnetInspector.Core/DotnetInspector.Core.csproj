<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Richard Lander</Authors>
    <Description>Transitional document readers and operational diagnostics for dotnet-inspect</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotnetInspector.Services.Tests" />
    <InternalsVisibleTo Include="DotnetInspect.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InertText\InertText.csproj" />
    <ProjectReference Include="..\DotnetInspector.Cache\DotnetInspector.Cache.csproj" />
    <ProjectReference Include="..\DotnetInspector.Networking\DotnetInspector.Networking.csproj" />
  </ItemGroup>
</Project>
