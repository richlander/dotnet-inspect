<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Richard Lander</Authors>
    <Description>IL-to-C# decompiler built on algorithms ported from dotnet/runtime</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ILInspector.Decompiler.Tests" />
    <InternalsVisibleTo Include="ILInspector.Research" />
    <!-- The diagnostic harness drives internal pipeline types directly
         (IrFunction, PassContext, StructuringDiagnostics) for stage dumps and
         stop-reason tallies. The runtime-ported ILReader it once needed from
         here is now public in ILInspector.Instructions. -->
    <InternalsVisibleTo Include="decompiler-harness" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\UnionPolyfill.cs" Link="UnionPolyfill.cs" />
    <ProjectReference Include="..\CSharpText\CSharpText.csproj" />
    <ProjectReference Include="..\ILInspector.CSharp\ILInspector.CSharp.csproj" />
    <ProjectReference Include="..\ILInspector.Findings\ILInspector.Findings.csproj" />
    <ProjectReference Include="..\ILInspector.ILDiff\ILInspector.ILDiff.csproj" />
    <ProjectReference Include="..\ILInspector.Metadata\ILInspector.Metadata.csproj" />
    <ProjectReference Include="..\ILInspector.MetadataPrimitives\ILInspector.MetadataPrimitives.csproj" />
    <ProjectReference Include="..\ILInspector.Instructions\ILInspector.Instructions.csproj" />
    <ProjectReference Include="..\ILInspector.ControlFlow\ILInspector.ControlFlow.csproj" />
    <ProjectReference Include="..\ILInspector.Text\ILInspector.Text.csproj" />
  </ItemGroup>

</Project>
