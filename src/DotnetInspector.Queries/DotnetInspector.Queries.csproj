<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <DotnetInspectWebsiteUrl Condition="'$(DotnetInspectWebsiteUrl)' == ''">https://dotnet-inspect.ca</DotnetInspectWebsiteUrl>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Richard Lander</Authors>
    <Description>Typed inspection queries, workspace, and result contracts for dotnet-inspect consumers</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inspector.Artifacts.Workspaces\Inspector.Artifacts.Workspaces.csproj" />
    <ProjectReference Include="..\DotnetInspector.DocumentationHouse\DotnetInspector.DocumentationHouse.csproj" />
    <ProjectReference Include="..\DotnetInspector.Libraries\DotnetInspector.Libraries.csproj" />
    <ProjectReference Include="..\DotnetInspector.LibraryMetadata\DotnetInspector.LibraryMetadata.csproj" />
    <ProjectReference Include="..\DotnetInspector.Packages\DotnetInspector.Packages.csproj" />
    <ProjectReference Include="..\DotnetInspector.Platforms.Packages\DotnetInspector.Platforms.Packages.csproj" />
    <ProjectReference Include="..\QuerySpace\QuerySpace.csproj" />
    <ProjectReference Include="..\DotnetInspector.SourceSelection\DotnetInspector.SourceSelection.csproj" />
    <ProjectReference Include="..\DotnetInspector.SourceHouse\DotnetInspector.SourceHouse.csproj" />
    <ProjectReference Include="..\DotnetInspector.Services\DotnetInspector.Services.csproj" />
    <ProjectReference Include="..\NuGetFetch\NuGetFetch.csproj" />
    <ProjectReference Include="..\Inspector.Findings\Inspector.Findings.csproj" />
    <ProjectReference Include="..\ILInspector.Analysis\ILInspector.Analysis.csproj" />
    <ProjectReference Include="..\ILInspector.CallGraph\ILInspector.CallGraph.csproj" />
    <ProjectReference Include="..\ILInspector.Decompiler\ILInspector.Decompiler.csproj" />
    <ProjectReference Include="..\ILInspector.Metadata\ILInspector.Metadata.csproj" />
    <ProjectReference Include="..\ILInspector.SourceLink\ILInspector.SourceLink.csproj" />
    <ProjectReference Include="..\UntrustedDocuments\UntrustedDocuments.csproj" />
    <PackageReference Include="NuGet.Frameworks" />
    <PackageReference Include="NuGet.Versioning" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotnetInspector.Queries.Tests" />
    <InternalsVisibleTo Include="DotnetInspector.Presentation.Tests" />
    <InternalsVisibleTo Include="DotnetInspect.Cli.Tests" />
    <InternalsVisibleTo Include="DotnetInspect.Web.Tests" />
    <InternalsVisibleTo Include="DotnetInspector.Sections.Tests" />
    <InternalsVisibleTo Include="DotnetInspector.Sections" />
    <InternalsVisibleTo Include="DotnetInspector.PackageQueries" />
    <!--
      The companion query assembly reuses the participant loop and the group's snapshot access so
      Research projections keep session and snapshot ownership inside the query layer. Keeping
      Research out of core query consumers is why it is a separate assembly rather than a namespace
      here; core Queries owns its Decompiler dependency for the group source fallback.
    -->
    <InternalsVisibleTo Include="DotnetInspector.ResearchQueries" />
  </ItemGroup>

  <Target Name="GenerateWorkspaceShareUrl" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_WorkspaceShareUrlSource>$(IntermediateOutputPath)WorkspaceShareUrl.g.cs</_WorkspaceShareUrlSource>
    </PropertyGroup>
    <ItemGroup>
      <_WorkspaceShareUrlSourceLines Include="// &lt;auto-generated /&gt;" />
      <_WorkspaceShareUrlSourceLines Include="namespace DotnetInspector.Queries.Definitions%3B" />
      <_WorkspaceShareUrlSourceLines Include="public static class WorkspaceShareUrl" />
      <_WorkspaceShareUrlSourceLines Include="{" />
      <_WorkspaceShareUrlSourceLines Include="    public const string WebsiteUrl = &quot;$(DotnetInspectWebsiteUrl)&quot;%3B" />
      <_WorkspaceShareUrlSourceLines Include="    public const string Prefix = WebsiteUrl + &quot;/%3Fw=&quot;%3B" />
      <_WorkspaceShareUrlSourceLines Include="    public static string Create(string packet) =&gt; Prefix + packet%3B" />
      <_WorkspaceShareUrlSourceLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile
        File="$(_WorkspaceShareUrlSource)"
        Lines="@(_WorkspaceShareUrlSourceLines)"
        Overwrite="true"
        WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_WorkspaceShareUrlSource)" />
      <FileWrites Include="$(_WorkspaceShareUrlSource)" />
    </ItemGroup>
  </Target>

</Project>
