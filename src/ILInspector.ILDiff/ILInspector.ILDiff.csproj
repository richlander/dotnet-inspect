<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Richard Lander</Authors>
    <Description>IL body and assembly comparison, Finding projection, and producer-owned diff presentation over the shared instruction substrate</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ILInspector.ILDiff.Tests" />
    <!-- SPIKE (exp/staged-diff-spike): eng/measure-staged-diff.cs reuses the
         complete diff's comparison primitives with early exit. -->
    <InternalsVisibleTo Include="measure-staged-diff" />
    <InternalsVisibleTo Include="measure-shared-predicate" />
    <InternalsVisibleTo Include="measure-canonical-walker" />
    <InternalsVisibleTo Include="measure-census-classes" />
    <!-- SPIKE (exp/unified-diff-exists): eng/measure-unified-diff.cs. -->
    <InternalsVisibleTo Include="measure-unified-diff" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inspector.Findings\Inspector.Findings.csproj" />
    <ProjectReference Include="..\ILInspector.Instructions\ILInspector.Instructions.csproj" />
    <ProjectReference Include="..\ILInspector.MetadataPrimitives\ILInspector.MetadataPrimitives.csproj" />
    <ProjectReference Include="..\Inspector.Text\Inspector.Text.csproj" />
  </ItemGroup>

</Project>
