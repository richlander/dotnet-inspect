<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Richard Lander</Authors>
    <Description>Package-backed platform discovery and realization and the PlatformHouse adapter and execution for authorized package sources</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DotnetInspector.PlatformHouse/DotnetInspector.PlatformHouse.csproj" />
    <ProjectReference Include="../DotnetInspector.Packages/DotnetInspector.Packages.csproj" />
    <ProjectReference Include="../DotnetInspector.Platforms/DotnetInspector.Platforms.csproj" />
    <ProjectReference Include="../ILInspector.Metadata/ILInspector.Metadata.csproj" />
  </ItemGroup>

</Project>
