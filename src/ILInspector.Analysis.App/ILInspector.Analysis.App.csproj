<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>

    <!-- A separate development entry point, outside the CLI's reference closure
         and outside the stderr-ownership rule (#3319). -->
    <OwnsItsOwnStderr>true</OwnsItsOwnStderr>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ILInspector.Analysis\ILInspector.Analysis.csproj" />
  </ItemGroup>

</Project>
