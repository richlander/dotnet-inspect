<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Richard Lander</Authors>
    <Description>Selects a complete member declaration from C# source text using caller-supplied line evidence. Not a C# parser: it has no syntax tree and is conservative at uncertain boundaries.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CSharpText.MemberSlicing.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CSharpText/CSharpText.csproj" />
  </ItemGroup>

</Project>
