<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Richard Lander</Authors>
    <Description>Host-neutral PackageHouse integration for DocumentationHouse</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DotnetInspector.DocumentationHouse.Contracts/DotnetInspector.DocumentationHouse.Contracts.csproj" />
    <ProjectReference Include="../DotnetInspector.Libraries/DotnetInspector.Libraries.csproj" />
    <ProjectReference Include="../DotnetInspector.PackageHouse.Execution/DotnetInspector.PackageHouse.Execution.csproj" />
  </ItemGroup>

</Project>
