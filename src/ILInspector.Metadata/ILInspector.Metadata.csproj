<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Richard Lander</Authors>
    <Description>A library for inspecting .NET assembly metadata</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="dotnet-inspect.Tests" />
    <InternalsVisibleTo Include="ILInspector.Metadata.Tests" />
    <!-- The compile-back harness forwards the decompiler's acquisition-backed
         current-assembly platform trust into API provenance extraction. -->
    <InternalsVisibleTo Include="decompiler-harness" />
    <!-- FidelityCheck is linked into this test host, which exercises the same
         trust-bearing harness path without widening the product API. -->
    <InternalsVisibleTo Include="ILInspector.Decompiler.Tests" />
    <!-- The renderer tests cross a subsystem boundary to build projection
         fixtures with the same containment policy the projector applies,
         rather than duplicating TextPolicy.Field in test code. This grants
         exactly MetadataTableProjector.ContainCellText; making that factory
         public would expose a larger surface. -->
    <InternalsVisibleTo Include="DotnetInspector.MetadataRendering.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharpText\CSharpText.csproj" />
    <ProjectReference Include="..\DotnetInspector.Artifacts\DotnetInspector.Artifacts.csproj" />
    <ProjectReference Include="..\ILInspector.Findings\ILInspector.Findings.csproj" />
    <ProjectReference Include="..\InertText\InertText.csproj" />
    <ProjectReference Include="..\ILInspector.MetadataPrimitives\ILInspector.MetadataPrimitives.csproj" />
  </ItemGroup>

  <!-- System.Reflection.Metadata is part of net10.0 BCL -->

</Project>
