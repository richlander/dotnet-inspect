<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Richard Lander</Authors>
    <Description>A library for inspecting .NET assembly metadata</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="dotnet-inspect.Tests" />
    <InternalsVisibleTo Include="ILInspector.Metadata.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- CSharp owns this spelling policy. Metadata source-links the internal
         classifier while its legacy API surface still produces C# strings. -->
    <Compile Include="..\ILInspector.CSharp\CSharpKeywords.cs" Link="CSharpKeywords.cs" />
    <ProjectReference Include="..\ILInspector.Findings\ILInspector.Findings.csproj" />
    <ProjectReference Include="..\ILInspector.MetadataPrimitives\ILInspector.MetadataPrimitives.csproj" />
    <ProjectReference Include="..\ILInspector.Text\ILInspector.Text.csproj" />
    <ProjectReference Include="..\SourceLinkFetch\SourceLinkFetch.csproj" />
  </ItemGroup>

  <!-- System.Reflection.Metadata is part of net10.0 BCL -->

</Project>
