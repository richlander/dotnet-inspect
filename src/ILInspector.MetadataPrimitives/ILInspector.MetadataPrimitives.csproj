<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Richard Lander</Authors>
    <Description>Dependency-free metadata and name-matching primitives shared by inspection layers</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ILInspector.ILDiff" />
    <InternalsVisibleTo Include="ILInspector.Metadata" />
    <InternalsVisibleTo Include="ILInspector.Metadata.Tests" />
    <!-- SPIKE (exp/unified-diff-exists, #9918): SymbolKey moved here as a shared
         primitive so the complete IL diff can key methods and operands by it. -->
    <InternalsVisibleTo Include="DotnetInspect.Cli.Tests" />
    <InternalsVisibleTo Include="measure-staged-diff" />
    <InternalsVisibleTo Include="measure-shared-predicate" />
    <InternalsVisibleTo Include="measure-canonical-walker" />
    <InternalsVisibleTo Include="measure-census-classes" />
    <InternalsVisibleTo Include="measure-unified-diff" />
    <InternalsVisibleTo Include="measure-map-facts" />
    <!-- SPIKE (exp/unified-diff-exists): eng/census-uncertain-kinds.cs. -->
    <InternalsVisibleTo Include="census-uncertain-kinds" />
  </ItemGroup>

  <!-- SRM-only by design: no project references. System.Reflection.Metadata is part of the BCL. -->

</Project>
