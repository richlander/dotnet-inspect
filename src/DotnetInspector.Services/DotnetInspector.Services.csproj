<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Richard Lander</Authors>
    <Description>Shared services for NuGet package resolution and project asset discovery</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotnetInspector.Services.Tests" />
    <InternalsVisibleTo Include="dotnet-inspect.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DotnetInspector.Metadata/DotnetInspector.Metadata.csproj" />
    <ProjectReference Include="../DotnetInspector.Packages/DotnetInspector.Packages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="NuGet.Frameworks" HintPath="..\..\..\NuGet.Client\artifacts\NuGet.Frameworks\bin\Release\net10.0\NuGet.Frameworks.dll" />
    <Reference Include="NuGet.Packaging" HintPath="..\..\..\NuGet.Client\artifacts\NuGet.Packaging\bin\Release\net10.0\NuGet.Packaging.dll" />
    <Reference Include="NuGet.Versioning" HintPath="..\..\..\NuGet.Client\artifacts\NuGet.Versioning\bin\Release\net10.0\NuGet.Versioning.dll" />
  </ItemGroup>

  <!-- Use ProjectReference for local Markout development, PackageReference for releases -->
  <!-- ProjectReference: local development
  <ItemGroup>
    <ProjectReference Include="..\..\..\markout\src\MarkdownTable.Formatting\MarkdownTable.Formatting.csproj" />
  </ItemGroup>
  -->
  <!-- PackageReference: releases -->
  <ItemGroup>
    <PackageReference Include="MarkdownTable.Formatting" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

</Project>
