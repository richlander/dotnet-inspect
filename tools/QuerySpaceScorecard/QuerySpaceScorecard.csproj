<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The scorecard harness entry point: checks and times the NLinq oracle and the
    System.Linq reference over the public-methods population of pinned
    assemblies, and is the shape an enablement copies to add its Old and
    Planner columns. Publish NativeAOT to time:
      dotnet publish tools/QuerySpaceScorecard -c Release -r <rid> -p:PublishAot=true -p:IsPublishable=true -o <dir>
    See docs/evidence-and-validation.md#performance-oracles-for-queryspace-enablement.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <AssemblyName>queryspace-scorecard</AssemblyName>
    <RootNamespace>QuerySpaceScorecard</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tests\DotnetInspector.PerformanceOracles\DotnetInspector.PerformanceOracles.csproj" />
  </ItemGroup>

</Project>
