<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Demand-driven scorecard for #8577's shallow retained instruction sequence.
    Publish NativeAOT to time:
      dotnet publish tools/MethodBodyDemandScorecard -c Release -r <rid> -p:PublishAot=true -p:IsPublishable=true -o <dir>
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <AssemblyName>method-body-demand-scorecard</AssemblyName>
    <RootNamespace>MethodBodyDemandScorecard</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tests\DotnetInspector.PerformanceOracles\DotnetInspector.PerformanceOracles.csproj" />
  </ItemGroup>

</Project>
