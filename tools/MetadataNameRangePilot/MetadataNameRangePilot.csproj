<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NativeAOT pilot comparing eager contained metadata names with per-name and
    population-backed opaque UTF-8 ranges.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <PublishAot>true</PublishAot>
    <AssemblyName>metadata-name-range-pilot</AssemblyName>
    <RootNamespace>MetadataNameRangePilot</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/InertText/InertText.csproj" />
  </ItemGroup>

</Project>
