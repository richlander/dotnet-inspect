<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <IsPackable>false</IsPackable>
    <AssemblyName>analysis-harness</AssemblyName>
    <RootNamespace>ILInspector.AnalysisHarness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ILInspector.Analysis/ILInspector.Analysis.csproj" />
    <ProjectReference Include="../../src/ILInspector.Instructions/ILInspector.Instructions.csproj" />
    <ProjectReference Include="../../src/DotnetInspector.Core/DotnetInspector.Core.csproj" />
    <ProjectReference Include="../../src/DotnetInspector.Packages/DotnetInspector.Packages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markout" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="corpus/paydirt-reference.json" CopyToOutputDirectory="PreserveNewest" Link="corpus/paydirt-reference.json" />
    <Content Include="corpus/structural-clone-relationships.json" CopyToOutputDirectory="PreserveNewest" Link="corpus/structural-clone-relationships.json" />
    <Content Include="corpus/structural-clone-corelib.json" CopyToOutputDirectory="PreserveNewest" Link="corpus/structural-clone-corelib.json" />
    <Content Include="corpus/structural-clone-cross-assembly.json" CopyToOutputDirectory="PreserveNewest" Link="corpus/structural-clone-cross-assembly.json" />
    <Content Include="corpus/historical-performance-reference.json" CopyToOutputDirectory="PreserveNewest" Link="corpus/historical-performance-reference.json" />
  </ItemGroup>

</Project>
