{"scope":{"profile":"query-preparation/v1","resource":"package-query/query-space/v1","root":"package-query/query","population":"selected-facets","completeness":"Complete","catalog_facets":19},"facets":{"package":{"name":"exact package","summary":"Selects one exact package ID.","operators":["eq"],"value_kind":"NuGet package ID","examples":["Newtonsoft.Json"],"effects":["AcquisitionTier: search-metadata"],"presentation_order":"0","control_kind":"input","presentation_kind":"value-query","execution_class":"search-metadata","selection_group":"population","combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[],"related_operations":[]},"prefix":{"name":"package prefix","summary":"Selects package IDs beginning with one literal prefix.","operators":["eq"],"value_kind":"NuGet package ID prefix","examples":["Microsoft.Extensions."],"effects":["AcquisitionTier: search-metadata"],"presentation_order":"1","control_kind":"input","presentation_kind":"value-query","execution_class":"search-metadata","selection_group":"population","combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[],"related_operations":[]},"ecosystem":{"name":"ecosystem","summary":"Selects an ecosystem\u0027s core packages and every package under its recorded package-ID prefixes.","operators":["eq"],"value_kind":"canonical ecosystem ID","examples":["ecosystem.aspire"],"effects":["AcquisitionTier: search-metadata"],"presentation_order":"2","control_kind":"input","presentation_kind":"value-query","execution_class":"search-metadata","selection_group":"population","combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[],"related_operations":[]},"prerelease":{"name":"package versions","summary":"Selects stable versions or includes prerelease versions.","operators":["eq"],"value_kind":"closed value","examples":["include"],"effects":["AcquisitionTier: search-metadata"],"values":["stable","include"],"presentation_order":"3","control_kind":"choice","presentation_kind":"fact","execution_class":"search-metadata","selection_group":"prerelease","combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[{"value":"stable","label":"Stable","summary":"Select stable package versions."},{"value":"include","label":"Include prerelease","summary":"Include prerelease package versions."}],"related_operations":[]},"dependencies":{"name":"dependencies","summary":"Matches dependency absence or package-ID boundary in the selected scope.","operators":["eq"],"value_kind":"closed value","examples":["none"],"effects":["AcquisitionTier: nuspec"],"values":["none","cross-prefix"],"presentation_order":"4","control_kind":"choice","presentation_kind":"fact","execution_class":"nuspec","selection_group":"dependencies","combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[{"value":"none","label":"no dependencies","summary":"The selected dependency scope declares no dependencies."},{"value":"cross-prefix","label":"cross-prefix dependency","summary":"The selected dependency scope declares a package from another first dot-delimited ID segment."}],"related_operations":["package.dependencies.inspect"]},"dependency-target":{"name":"dependency target","summary":"Scopes dependency terms to all manifest groups or one TFM-selected group.","operators":["eq"],"value_kind":"all or NuGet target framework","examples":["net8.0"],"effects":["AcquisitionTier: nuspec"],"input_rules":["Requires at least one depends, depends-transitive, depends-ecosystem, or dependencies term; applies to all dependency predicates in the query.","Dependency traversal requires an explicit dependency-target=\u003Ctfm\u003E; all is not accepted with dependency-depth or depends-transitive."],"values":["all","net11.0","net10.0","net9.0","net8.0","net7.0","net6.0","netstandard2.1","netstandard2.0","net48","net472"],"presentation_order":"5","control_kind":"input","presentation_kind":"value-query","execution_class":"nuspec","selection_group":"dependency-target","combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[{"value":"all","label":"All target frameworks","summary":"Do not filter declared dependency groups by target framework."},{"value":"net11.0","label":"net11.0","summary":"Use the exact NuGet target framework \u0027net11.0\u0027."},{"value":"net10.0","label":"net10.0","summary":"Use the exact NuGet target framework \u0027net10.0\u0027."},{"value":"net9.0","label":"net9.0","summary":"Use the exact NuGet target framework \u0027net9.0\u0027."},{"value":"net8.0","label":"net8.0","summary":"Use the exact NuGet target framework \u0027net8.0\u0027."},{"value":"net7.0","label":"net7.0","summary":"Use the exact NuGet target framework \u0027net7.0\u0027."},{"value":"net6.0","label":"net6.0","summary":"Use the exact NuGet target framework \u0027net6.0\u0027."},{"value":"netstandard2.1","label":"netstandard2.1","summary":"Use the exact NuGet target framework \u0027netstandard2.1\u0027."},{"value":"netstandard2.0","label":"netstandard2.0","summary":"Use the exact NuGet target framework \u0027netstandard2.0\u0027."},{"value":"net48","label":"net48","summary":"Use the exact NuGet target framework \u0027net48\u0027."},{"value":"net472","label":"net472","summary":"Use the exact NuGet target framework \u0027net472\u0027."}],"related_operations":["package.dependencies.inspect"]},"depends":{"name":"depends on package","summary":"Matches a direct dependency, or exact package reachability through dependency-depth.","operators":["eq","starts-with"],"value_kind":"NuGet package ID or prefix","examples":["Microsoft.Extensions.DependencyInjection"],"effects":["AcquisitionTier: nuspec"],"input_rules":["Without dependency-depth, eq matches direct dependencies and starts-with matches direct package-ID prefixes. With dependency-depth=2, 3, or 4, eq matches direct or transitive declaration paths through that maximum; starts-with remains direct. A starts-with predicate alone cannot admit depth.","With dependency-depth, supply an explicit dependency-target=\u003Ctfm\u003E, not all, and admit at most 5 package candidates; an exact package input admits one. Repeated exact terms AND and share traversal."],"presentation_order":"6","control_kind":"input","presentation_kind":"value-query","execution_class":"nuspec","selection_group":null,"combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[],"related_operations":["package.dependencies.inspect"]},"depends-ecosystem":{"name":"depends on ecosystem","summary":"Matches a direct dependency in a registered ecosystem package population.","operators":["eq"],"value_kind":"canonical ecosystem ID","examples":["ecosystem.aspire"],"effects":["AcquisitionTier: nuspec"],"presentation_order":"7","control_kind":"input","presentation_kind":"value-query","execution_class":"nuspec","selection_group":null,"combines_within_selection_group":false,"replacement_group":null,"option_source":"product-ecosystems","options":[],"related_operations":["package.dependencies.inspect"]},"depends-transitive":{"name":"transitively depends on package","summary":"Legacy spelling for source-authorized dependency reachability at depth 2 or greater.","operators":["eq"],"value_kind":"NuGet package ID","examples":["Microsoft.Extensions.Primitives"],"effects":["AcquisitionTier: nuspec"],"input_rules":["Requires an explicit dependency-target=\u003Ctfm\u003E and dependency-depth=2, 3, or 4; all is not accepted as the target.","Matches declaration edges at depth 2 through the selected maximum depth; direct-only dependencies do not match. Repeated terms AND and share traversal.","Admits at most 5 package candidates; an exact package input admits one. Set the candidate bound explicitly for a prefix or ecosystem population."],"presentation_order":"8","control_kind":"input","presentation_kind":"value-query","execution_class":"nuspec-expensive","selection_group":null,"combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[],"requires":["dependency-target","dependency-depth"],"related_operations":["package.dependencies.inspect"]},"dependency-depth":{"name":"dependency depth","summary":"Extends exact depends terms through the selected maximum declaration-edge depth.","operators":["eq"],"value_kind":"closed value","examples":["2"],"effects":["AcquisitionTier: nuspec"],"input_rules":["Requires an explicit dependency-target=\u003Ctfm\u003E and at least one exact depends (eq) or legacy depends-transitive term. A starts-with predicate alone cannot satisfy this requirement; all is not accepted as the target.","Selects the maximum declaration-edge depth, not the result row limit. Prefer exact depends plus depth for new queries; depends-transitive remains the depth-2-or-greater legacy spelling.","Admits at most 5 package candidates; an exact package input admits one. Set the candidate bound explicitly for a prefix or ecosystem population."],"values":["2","3","4"],"presentation_order":"9","control_kind":"choice","presentation_kind":"fact","execution_class":"nuspec-expensive","selection_group":"dependency-depth","combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[{"value":"2","label":"Depth 2","summary":"Traverse through two declaration edges."},{"value":"3","label":"Depth 3","summary":"Traverse through three declaration edges."},{"value":"4","label":"Depth 4","summary":"Traverse through four declaration edges."}],"requires":["dependency-target"],"related_operations":["package.dependencies.inspect"]},"license":{"name":"license","summary":"Matches license presence or a closed license identity derived from nuspec metadata.","operators":["eq"],"value_kind":"closed value","examples":["MIT"],"effects":["AcquisitionTier: nuspec"],"values":["any","MIT","OSMF"],"presentation_order":"10","control_kind":"choice","presentation_kind":"fact","execution_class":"nuspec","selection_group":null,"combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[{"value":"any","label":"has license","summary":"The nuspec declares a license."},{"value":"MIT","label":"MIT","summary":"The nuspec declares the exact SPDX expression MIT."},{"value":"OSMF","label":"OSMF","summary":"The nuspec declares an OSMFEULA.* license file."}],"related_operations":[]},"downloads":{"name":"downloads","summary":"Matches a closed lifetime-download threshold reported by the package source.","operators":["eq"],"value_kind":"closed value","examples":["100k"],"effects":["AcquisitionTier: search-metadata"],"values":["10k","100k","1m"],"presentation_order":"11","control_kind":"choice","presentation_kind":"fact","execution_class":"search-metadata","selection_group":"downloads","combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[{"value":"10k","label":"10k\u002B downloads","summary":"At least ten thousand downloads."},{"value":"100k","label":"100k\u002B downloads","summary":"At least one hundred thousand downloads."},{"value":"1m","label":"1M\u002B downloads","summary":"At least one million downloads."}],"related_operations":[]},"readme":{"name":"embedded README","summary":"Matches a package manifest that declares an embedded README.","operators":["eq"],"value_kind":"boolean","examples":["true"],"effects":["AcquisitionTier: nuspec"],"values":["true"],"presentation_order":"12","control_kind":"toggle","presentation_kind":"fact","execution_class":"nuspec","selection_group":null,"combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[{"value":"true","label":"embedded README","summary":"The manifest declares an embedded README."}],"related_operations":[]},"tool":{"name":".NET Tool","summary":"Matches the .NET tool package type from the package manifest.","operators":["eq"],"value_kind":"boolean","examples":["true"],"effects":["AcquisitionTier: nuspec"],"values":["true"],"presentation_order":"13","control_kind":"toggle","presentation_kind":"fact","execution_class":"nuspec","selection_group":null,"combines_within_selection_group":false,"replacement_group":"package.query.replacement.dotnet-tool","option_source":null,"options":[{"value":"true","label":".NET Tool","summary":"The manifest declares a .NET tool package type."}],"related_operations":[]},"tool-format":{"name":"DotnetCliTool","summary":"Downloads the package and matches the DotnetCliTool format version in its DotnetToolSettings.xml.","operators":["eq"],"value_kind":"closed value","examples":["v2"],"effects":["AcquisitionTier: package-content","Capability: package-content-provider"],"values":["v1","v2"],"presentation_order":"14","control_kind":"choice","presentation_kind":"value-query","execution_class":"package-content","selection_group":"tool-format","combines_within_selection_group":true,"replacement_group":"package.query.replacement.dotnet-tool","option_source":null,"options":[{"value":"v1","label":"v1","summary":"Portable DotNetCliTool format (Version=\u00221\u0022)."},{"value":"v2","label":"v2","summary":"RID-specific DotNetCliTool format (Version=\u00222\u0022)."}],"related_operations":[]},"references":{"name":"references assembly","summary":"Downloads the package and matches AssemblyRef simple names across managed ref and lib assets.","operators":["eq"],"value_kind":"assembly simple name","examples":["Microsoft.Extensions.DependencyInjection.Abstractions"],"effects":["AcquisitionTier: package-content","Capability: package-content-provider"],"presentation_order":"15","control_kind":"input","presentation_kind":"value-query","execution_class":"metadata","selection_group":null,"combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[],"related_operations":[]},"skill":{"name":"embedded SKILL.md","summary":"Downloads the package and matches a skills/SKILL.md or skills/**/SKILL.md file.","operators":["eq"],"value_kind":"boolean","examples":["true"],"effects":["AcquisitionTier: package-content","Capability: package-content-provider"],"values":["true"],"presentation_order":"16","control_kind":"toggle","presentation_kind":"fact","execution_class":"package-content","selection_group":null,"combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[{"value":"true","label":"embedded SKILL.md","summary":"The package contains a skill document."}],"related_operations":[]},"library-literal":{"name":"library literal","summary":"Downloads the package and matches decoded string-literal uses across the selected implementation libraries.","operators":["eq"],"value_kind":"decoded UTF-16 text","examples":["https://"],"effects":["AcquisitionTier: package-content","Capability: package-content-provider"],"input_rules":["Any decoded UTF-16 text within these constraints is accepted; the empty values list is not an allow list.","Length: 1..1024 UTF-16 code units.","Preserve all operand text, including whitespace, newlines, and case; do not normalize.","Match an ordinal substring of each decoded string-literal use.","Single distinct operand: identical repeated values collapse; distinct values are incompatible.","Queries using this facet admit at most five package candidates; an exact package ID admits at most one."],"presentation_order":"17","control_kind":"multiline-input","presentation_kind":"value-query","execution_class":"metadata-expensive","selection_group":null,"combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[],"requires":["library-target"],"related_operations":[]},"library-target":{"name":"library target","summary":"Records the exact target framework used to select the implementation libraries.","operators":["eq"],"value_kind":"NuGet target framework","examples":["net10.0"],"effects":["AcquisitionTier: package-content","Capability: package-content-provider"],"values":["net11.0","net10.0","net9.0","net8.0","net7.0","net6.0","netstandard2.1","netstandard2.0","net48","net472"],"presentation_order":"18","control_kind":"input","presentation_kind":"value-query","execution_class":"metadata-expensive","selection_group":null,"combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[{"value":"net11.0","label":"net11.0","summary":"Use the exact NuGet target framework \u0027net11.0\u0027."},{"value":"net10.0","label":"net10.0","summary":"Use the exact NuGet target framework \u0027net10.0\u0027."},{"value":"net9.0","label":"net9.0","summary":"Use the exact NuGet target framework \u0027net9.0\u0027."},{"value":"net8.0","label":"net8.0","summary":"Use the exact NuGet target framework \u0027net8.0\u0027."},{"value":"net7.0","label":"net7.0","summary":"Use the exact NuGet target framework \u0027net7.0\u0027."},{"value":"net6.0","label":"net6.0","summary":"Use the exact NuGet target framework \u0027net6.0\u0027."},{"value":"netstandard2.1","label":"netstandard2.1","summary":"Use the exact NuGet target framework \u0027netstandard2.1\u0027."},{"value":"netstandard2.0","label":"netstandard2.0","summary":"Use the exact NuGet target framework \u0027netstandard2.0\u0027."},{"value":"net48","label":"net48","summary":"Use the exact NuGet target framework \u0027net48\u0027."},{"value":"net472","label":"net472","summary":"Use the exact NuGet target framework \u0027net472\u0027."}],"related_operations":[]}},"facet_order":["package","prefix","ecosystem","prerelease","dependencies","dependency-target","depends","depends-ecosystem","depends-transitive","dependency-depth","license","downloads","readme","tool","tool-format","references","skill","library-literal","library-target"],"bindings":{"dotnet-inspect.cli/package-query":{"consumer_kind":"Cli","gesture":"package query","input_rules":["Supply a package ID or PREFIX* as the positional argument after package query.","Supply exposed inspection facets through --where \u0022key=value\u0022 for eq or --where \u0022key starts-with value\u0022 for starts-with; use only operators exposed by the facet.","Set the package-candidate work bound through --take N; -n N selects final result rows and does not replace that bound for inspection predicates.","Use --json for structured query result output.","Supply library-target through --tfm TFM, not --where. Use one exact NuGet target framework.","library-literal and --tfm require each other; neither is valid alone."],"exposed_facets":["dependencies","dependency-target","depends","depends-ecosystem","depends-transitive","dependency-depth","license","downloads","readme","tool","tool-format","references","skill","library-literal"]}}}
