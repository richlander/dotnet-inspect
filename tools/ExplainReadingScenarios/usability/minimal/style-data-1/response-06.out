{"format_version":1,"selection":{"kind":"vocabulary-data","completeness":"Complete"},"identity":{"owner":"product-vocabulary","schema":"installed","type":"value-vocabulary","value":"20:csharp.style-choices"},"path":"vocabularies/csharp.style-choices","vocabularies":{"csharp.style-choices":{"identity":{"owner":"product-vocabulary","schema":"installed","type":"value-vocabulary","value":"20:csharp.style-choices"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices"}],"fact_states":{},"facts":{"identity":"csharp.style-choices","name":"C# Style Choices","summary":"Selectable product-owned C# rendering choices.","members":"17","accepted-by":["decompiler.style-picker","decompiler.render"],"maps":[{"identity":"option","name":"Option","summary":"Owning style option identity.","value-kind":"text","target-vocabulary":null,"cardinality":"exactly-one","coverage":"complete"},{"identity":"value","name":"Value","summary":"Selected value token on the owning option axis.","value-kind":"text","target-vocabulary":null,"cardinality":"exactly-one","coverage":"complete"},{"identity":"tier","name":"Tier","summary":"Owning fidelity/presentation tier.","value-kind":"term","target-vocabulary":"csharp.style-tiers","cardinality":"exactly-one","coverage":"complete"},{"identity":"byte_divergent","name":"Byte Divergent","summary":"Whether this choice may change emitted IL bytes.","value-kind":"boolean","target-vocabulary":null,"cardinality":"exactly-one","coverage":"complete"},{"identity":"oracle_endorsed","name":"Oracle Endorsed","summary":"Whether the declared runtime style oracle endorses this choice.","value-kind":"boolean","target-vocabulary":null,"cardinality":"exactly-one","coverage":"complete"},{"identity":"corpus_endorsed","name":"Corpus Endorsed","summary":"Whether the runtime source corpus endorses this choice.","value-kind":"boolean","target-vocabulary":null,"cardinality":"exactly-one","coverage":"complete"},{"identity":"conflict_group","name":"Conflict Group","summary":"Product-owned mutually-exclusive selection group.","value-kind":"text","target-vocabulary":null,"cardinality":"optional-one","coverage":"complete"}],"defaults":[]},"values":[{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices16:slot-local-names"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/slot-local-names"}],"fact_states":{},"id":"slot-local-names","name":"Use IL slot local names","summary":"Keep V_index for a local that has no PDB source name instead of synthesizing a readable name.","option":"slot-local-names","value":"true","tier":"Synthesis"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices27:approximate-pdb-local-names"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/approximate-pdb-local-names"}],"fact_states":{},"id":"approximate-pdb-local-names","name":"Prefer approximate PDB local names","summary":"When exact scoped identity cannot be represented, use a deterministic collision-resolved name associated with the physical PDB slot; fidelity remains Partial.","option":"approximate-pdb-local-names","value":"true","tier":"Synthesis"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices27:wrap-splittable-expressions"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/wrap-splittable-expressions"}],"fact_states":{},"id":"wrap-splittable-expressions","name":"Wrap long boolean chains","summary":"Break a long short-circuit \u0026\u0026/|| chain across lines instead of one very wide line (whitespace only).","option":"wrap-splittable-expressions","value":"true","tier":"Formatting"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices26:disable-one-liner-wrapping"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/disable-one-liner-wrapping"}],"fact_states":{},"id":"disable-one-liner-wrapping","name":"Keep one-liners on one line","summary":"Suppress the always-on width wrappers (long fluent chains and long member signatures) so a wide construct stays on a single physical line instead of wrapping (whitespace only).","option":"disable-one-liner-wrapping","value":"true","tier":"Formatting"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices26:wrap-expression-body-arrow"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/wrap-expression-body-arrow"}],"fact_states":{},"id":"wrap-expression-body-arrow","name":"Wrap expression-body arrow","summary":"Wrap the =\u003E of an expression-bodied member or accessor onto the next line instead of keeping it on the declaration line (whitespace only).","option":"wrap-expression-body-arrow","value":"true","tier":"Formatting"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices20:qualify-field-access"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/qualify-field-access"}],"fact_states":{},"id":"qualify-field-access","name":"Qualify field access with this.","summary":"Render this. on an instance field even where the bare name is unambiguous (IL-identical).","option":"qualify-field-access","value":"true","tier":"Spelling"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices23:qualify-property-access"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/qualify-property-access"}],"fact_states":{},"id":"qualify-property-access","name":"Qualify property access with this.","summary":"Render this. on an instance property even where the bare name is unambiguous (IL-identical).","option":"qualify-property-access","value":"true","tier":"Spelling"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices21:qualify-method-access"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/qualify-method-access"}],"fact_states":{},"id":"qualify-method-access","name":"Qualify method access with this.","summary":"Render this. on an instance method call even where the bare name is unambiguous (IL-identical).","option":"qualify-method-access","value":"true","tier":"Spelling"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices20:qualify-event-access"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/qualify-event-access"}],"fact_states":{},"id":"qualify-event-access","name":"Qualify event access with this.","summary":"Render this. on an instance event even where the bare name is unambiguous (IL-identical).","option":"qualify-event-access","value":"true","tier":"Spelling"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices51:guarded-boolean-return-style:conditional-expression"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/guarded-boolean-return-style.conditional-expression"}],"fact_states":{},"id":"guarded-boolean-return-style:conditional-expression","name":"Guarded boolean return style \u00B7 Conditional expression (ternary)","summary":"How to render a declined guarded boolean return: the byte-faithful flat if/return (default), the oracle-preferred ternary return c ? A : B; (byte-divergent), or the compact short-circuit \u0022bool hack\u0022 (byte-divergent, not oracle-endorsed).","option":"guarded-boolean-return-style","value":"conditional-expression","tier":"Lens"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices39:guarded-boolean-return-style:branchless"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/guarded-boolean-return-style.branchless"}],"fact_states":{},"id":"guarded-boolean-return-style:branchless","name":"Guarded boolean return style \u00B7 Branchless \u0022bool hack\u0022","summary":"How to render a declined guarded boolean return: the byte-faithful flat if/return (default), the oracle-preferred ternary return c ? A : B; (byte-divergent), or the compact short-circuit \u0022bool hack\u0022 (byte-divergent, not oracle-endorsed).","option":"guarded-boolean-return-style","value":"branchless","tier":"Lens"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices41:var-spelling-style:var-for-built-in-types"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/var-spelling-style.var-for-built-in-types"}],"fact_states":{},"id":"var-spelling-style:var-for-built-in-types","name":"var vs. explicit type \u00B7 var for built-in types","summary":"When to spell a local declaration with var instead of its explicit type: never (explicit, the default), for built-in types, when the type is apparent from the initializer, and/or elsewhere. Byte-neutral; the three var categories are independent, matching the csharp_style_var_* editorconfig keys.","option":"var-spelling-style","value":"var-for-built-in-types","tier":"Spelling"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices41:var-spelling-style:var-when-type-apparent"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/var-spelling-style.var-when-type-apparent"}],"fact_states":{},"id":"var-spelling-style:var-when-type-apparent","name":"var vs. explicit type \u00B7 var when the type is apparent","summary":"When to spell a local declaration with var instead of its explicit type: never (explicit, the default), for built-in types, when the type is apparent from the initializer, and/or elsewhere. Byte-neutral; the three var categories are independent, matching the csharp_style_var_* editorconfig keys.","option":"var-spelling-style","value":"var-when-type-apparent","tier":"Spelling"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices32:var-spelling-style:var-elsewhere"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/var-spelling-style.var-elsewhere"}],"fact_states":{},"id":"var-spelling-style:var-elsewhere","name":"var vs. explicit type \u00B7 var elsewhere","summary":"When to spell a local declaration with var instead of its explicit type: never (explicit, the default), for built-in types, when the type is apparent from the initializer, and/or elsewhere. Byte-neutral; the three var categories are independent, matching the csharp_style_var_* editorconfig keys.","option":"var-spelling-style","value":"var-elsewhere","tier":"Spelling"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices24:explicit-object-creation"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/explicit-object-creation"}],"fact_states":{},"id":"explicit-object-creation","name":"Use explicit object creation","summary":"Keep the constructed type in new T(...) instead of shortening to target-typed new(...) where the assignment target already supplies it.","option":"object-creation-style","value":"explicit","tier":"Spelling"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices21:enum-case-label-order"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/enum-case-label-order"}],"fact_states":{},"id":"enum-case-label-order","name":"Shared enum case-label order","summary":"Order named enum labels that share one switch body alphabetically (default) or by recovered numeric value. Byte-neutral; mixed or unnamed labels keep value order.","option":"enum-case-label-order","value":"value","tier":"Spelling"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"20:csharp.style-choices26:explicit-long-literal-cast"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-choices/values/explicit-long-literal-cast"}],"fact_states":{},"id":"explicit-long-literal-cast","name":"Use explicit long literal casts","summary":"Render compiler-shaped long constants as explicit (long)N casts instead of the default terse spelling: NL when a marker is required, or bare N when a binary sibling fixes long promotion. Genuine ldc.i8 sources keep their current spelling.","option":"prefer-long-literal-suffix","value":"false","tier":"Spelling"}],"property_sets":{"byte_divergent":["guarded-boolean-return-style:conditional-expression","guarded-boolean-return-style:branchless"],"oracle_endorsed":["qualify-field-access","qualify-property-access","qualify-method-access","qualify-event-access","guarded-boolean-return-style:conditional-expression"],"corpus_endorsed":["wrap-splittable-expressions"]},"property_groups":{"conflict_group":{"guarded-boolean-return-style":["guarded-boolean-return-style:conditional-expression","guarded-boolean-return-style:branchless"],"var-spelling-style":["var-spelling-style:var-for-built-in-types","var-spelling-style:var-when-type-apparent","var-spelling-style:var-elsewhere"]}}},"csharp.style-tiers":{"identity":{"owner":"product-vocabulary","schema":"installed","type":"value-vocabulary","value":"18:csharp.style-tiers"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-tiers"}],"fact_states":{},"facts":{"identity":"csharp.style-tiers","name":"C# Style Tiers","summary":"Fidelity and presentation tiers used to group C# style choices.","members":"4","accepted-by":["decompiler.style-picker"],"maps":[{"identity":"order","name":"Order","summary":"Product-owned presentation order.","value-kind":"integer","target-vocabulary":null,"cardinality":"exactly-one","coverage":"complete"},{"identity":"byte_divergent","name":"Byte Divergent","summary":"Whether every choice in the tier may change emitted IL bytes.","value-kind":"boolean","target-vocabulary":null,"cardinality":"exactly-one","coverage":"complete"}],"defaults":[]},"values":[{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"18:csharp.style-tiers10:Formatting"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-tiers/values/formatting"}],"fact_states":{},"id":"Formatting","name":"Formatting","summary":"Layout only \u2014 whitespace and line breaks. The code itself is unchanged, and compiles to identical IL.","order":"1"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"18:csharp.style-tiers8:Spelling"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-tiers/values/spelling"}],"fact_states":{},"id":"Spelling","name":"Spelling","summary":"An equally faithful way to spell the same code, such as qualifying a member with this or writing var. Compiles to identical IL.","order":"2"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"18:csharp.style-tiers9:Synthesis"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-tiers/values/synthesis"}],"fact_states":{},"id":"Synthesis","name":"Local naming","summary":"Readable or approximate display names for locals. Compiles to identical IL, but the selected names may not represent exact source identity.","order":"3"},{"identity":{"owner":"product-vocabulary","schema":"installed","type":"vocabulary-value","value":"18:csharp.style-tiers4:Lens"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"vocabularies/csharp.style-tiers/values/lens"}],"fact_states":{},"id":"Lens","name":"Style lenses","summary":"Keeps what the code does, but not the exact bytes: this rendering recompiles to different IL than the shipped output, so it is excluded from byte-level fidelity checking.","order":"4"}],"property_sets":{"byte_divergent":["Lens"]},"property_groups":{}}}}
