{"kind":"query-facet","name":"dependency target","summary":"Scopes dependency terms to all manifest groups or one TFM-selected group.","_links":{"self":{"href":"inspect-resource:/package-query/query/facets/dependency-target?projection=hal","title":"dependency target","type":"application/hal\u002Bjson"},"describedby":{"href":"inspect-resource:/package-query/query/facets/dependency-target?projection=contract","title":"Explanation schema for client development","type":"application/json"},"bindings":[{"href":"inspect-resource:/package-query/bindings/cli","title":"dotnet-inspect CLI","type":"application/json"}]},"key":"dependency-target","operators":["eq"],"value_kind":"all or NuGet target framework","examples":["net8.0"],"effects":["AcquisitionTier: nuspec"],"input_rules":["Requires at least one depends, depends-transitive, depends-ecosystem, or dependencies term; applies to all dependency predicates in the query.","Dependency traversal requires an explicit dependency-target=\u003Ctfm\u003E; all is not accepted with dependency-depth or depends-transitive."],"values":[],"id":"package-query.term.dependency-target","requires":[],"data_scope":{"completeness":"Complete"},"_embedded":{"facets":[],"bindings":[{"kind":"consumer-binding","name":"dotnet-inspect CLI","summary":"A production Cli binding for \u0027Package Query\u0027.","_links":{"self":{"href":"inspect-resource:/package-query/bindings/cli","title":"dotnet-inspect CLI","type":"application/json"},"exposed-facets":[{"href":"inspect-resource:/package-query/query/facets/dependency-target?projection=hal","title":"dependency target","type":"application/hal\u002Bjson"}]},"consumer_kind":"Cli","gesture":"package query","input_rules":["Supply a package ID or PREFIX* as the positional argument after package query.","Supply exposed inspection facets through --where key=value.","Set the package-candidate work bound through --take N; -n N selects final result rows and does not replace that bound for inspection predicates.","Use --json for structured query result output.","Supply library-target through --tfm TFM, not --where. Use one exact NuGet target framework.","library-literal and --tfm require each other; neither is valid alone."],"members":"14","id":"dotnet-inspect.cli/package-query","exposed_facets":["dependency-target"]}]}}
