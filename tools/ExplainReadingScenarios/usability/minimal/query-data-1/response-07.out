{"format_version":1,"selection":{"kind":"query-facets","completeness":"Complete"},"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet26:package-query.term.depends28:package-query/query-space/v1"},"path":"package-query/query/facets/depends","facts":{"identity":"package-query.term.depends","key":"depends","name":"depends on package","summary":"Matches a direct dependency, or exact package reachability through dependency-depth.","operators":["eq","starts-with"],"value-kind":"NuGet package ID or prefix","values":[],"examples":["Microsoft.Extensions.DependencyInjection"],"effects":["AcquisitionTier: nuspec"],"input-rules":["Without dependency-depth, eq matches direct dependencies and starts-with matches direct package-ID prefixes. With dependency-depth=2, 3, or 4, eq matches direct or transitive declaration paths through that maximum; starts-with remains direct. A starts-with predicate alone cannot admit depth.","With dependency-depth, supply an explicit dependency-target=\u003Ctfm\u003E, not all, and admit at most 5 package candidates; an exact package input admits one. Repeated exact terms AND and share traversal."]},"fact_states":{},"facets":{"depends":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet26:package-query.term.depends28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/depends"}],"fact_states":{},"facts":{"identity":"package-query.term.depends","key":"depends","name":"depends on package","summary":"Matches a direct dependency, or exact package reachability through dependency-depth.","operators":["eq","starts-with"],"value-kind":"NuGet package ID or prefix","values":[],"examples":["Microsoft.Extensions.DependencyInjection"],"effects":["AcquisitionTier: nuspec"],"input-rules":["Without dependency-depth, eq matches direct dependencies and starts-with matches direct package-ID prefixes. With dependency-depth=2, 3, or 4, eq matches direct or transitive declaration paths through that maximum; starts-with remains direct. A starts-with predicate alone cannot admit depth.","With dependency-depth, supply an explicit dependency-target=\u003Ctfm\u003E, not all, and admit at most 5 package candidates; an exact package input admits one. Repeated exact terms AND and share traversal."]},"requires":[]}},"facet_order":["depends"],"bindings":{"dotnet-inspect.cli/package-query":{"identity":{"owner":"consumer","schema":"installed","type":"consumer-binding","value":"15:ConsumerBinding32:dotnet-inspect.cli/package-query-1:"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/bindings/cli"}],"fact_states":{},"facts":{"identity":"dotnet-inspect.cli/package-query","name":"dotnet-inspect CLI","summary":"A production Cli binding for \u0027Package Query\u0027.","consumer-kind":"Cli","gesture":"package query","input-rules":["Supply a package ID or PREFIX* as the positional argument after package query.","Supply exposed inspection facets through --where key=value.","Set the package-candidate work bound through --take N; -n N selects final result rows and does not replace that bound for inspection predicates.","Use --json for structured query result output.","Supply library-target through --tfm TFM, not --where. Use one exact NuGet target framework.","library-literal and --tfm require each other; neither is valid alone."],"members":"14"},"exposed_facets":["depends"]}}}
