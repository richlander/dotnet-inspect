{"_links":{"collection":{"href":"inspect-resource:/package-query/query?projection=hal","type":"application/hal\u002Bjson"}},"_embedded":{"facets":[{"key":"dependency-target","name":"dependency target","summary":"Scopes dependency terms to all manifest groups or one TFM-selected group.","operators":["eq"],"value_kind":"all or NuGet target framework","examples":["net8.0"],"effects":["AcquisitionTier: nuspec"],"input_rules":["Requires at least one depends, depends-transitive, depends-ecosystem, or dependencies term; applies to all dependency predicates in the query.","Dependency traversal requires an explicit dependency-target=\u003Ctfm\u003E; all is not accepted with dependency-depth or depends-transitive."],"values":["all","net11.0","net10.0","net9.0","net8.0","net7.0","net6.0","netstandard2.1","netstandard2.0","net48","net472"],"presentation_order":"5","control_kind":"input","presentation_kind":"value-query","execution_class":"nuspec","selection_group":"dependency-target","combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[{"value":"all","label":"All target frameworks","summary":"Do not filter declared dependency groups by target framework."},{"value":"net11.0","label":"net11.0","summary":"Use the exact NuGet target framework \u0027net11.0\u0027."},{"value":"net10.0","label":"net10.0","summary":"Use the exact NuGet target framework \u0027net10.0\u0027."},{"value":"net9.0","label":"net9.0","summary":"Use the exact NuGet target framework \u0027net9.0\u0027."},{"value":"net8.0","label":"net8.0","summary":"Use the exact NuGet target framework \u0027net8.0\u0027."},{"value":"net7.0","label":"net7.0","summary":"Use the exact NuGet target framework \u0027net7.0\u0027."},{"value":"net6.0","label":"net6.0","summary":"Use the exact NuGet target framework \u0027net6.0\u0027."},{"value":"netstandard2.1","label":"netstandard2.1","summary":"Use the exact NuGet target framework \u0027netstandard2.1\u0027."},{"value":"netstandard2.0","label":"netstandard2.0","summary":"Use the exact NuGet target framework \u0027netstandard2.0\u0027."},{"value":"net48","label":"net48","summary":"Use the exact NuGet target framework \u0027net48\u0027."},{"value":"net472","label":"net472","summary":"Use the exact NuGet target framework \u0027net472\u0027."}],"related_operations":["package.dependencies.inspect"]},{"key":"depends","name":"depends on package","summary":"Matches a direct dependency, or exact package reachability through dependency-depth.","operators":["eq","starts-with"],"value_kind":"NuGet package ID or prefix","examples":["Microsoft.Extensions.DependencyInjection"],"effects":["AcquisitionTier: nuspec"],"input_rules":["Without dependency-depth, eq matches direct dependencies and starts-with matches direct package-ID prefixes. With dependency-depth=2, 3, or 4, eq matches direct or transitive declaration paths through that maximum; starts-with remains direct. A starts-with predicate alone cannot admit depth.","With dependency-depth, supply an explicit dependency-target=\u003Ctfm\u003E, not all, and admit at most 5 package candidates; an exact package input admits one. Repeated exact terms AND and share traversal."],"presentation_order":"6","control_kind":"input","presentation_kind":"value-query","execution_class":"nuspec","selection_group":null,"combines_within_selection_group":false,"replacement_group":null,"option_source":null,"options":[],"related_operations":["package.dependencies.inspect"]}],"bindings":[{"key":"dotnet-inspect.cli/package-query","consumer_kind":"Cli","gesture":"package query","input_rules":["Supply a package ID or PREFIX* as the positional argument after package query.","Supply exposed inspection facets through --where \u0022key=value\u0022 for eq or --where \u0022key starts-with value\u0022 for starts-with; use only operators exposed by the facet.","Set the package-candidate work bound through --take N; -n N selects final result rows and does not replace that bound for inspection predicates.","Use --json for structured query result output.","Supply library-target through --tfm TFM, not --where. Use one exact NuGet target framework.","library-literal and --tfm require each other; neither is valid alone."],"exposed_facets":["dependency-target","depends"]}]},"scope":{"profile":"query-preparation/v1","resource":"package-query/query-space/v1","root":"package-query/query","population":"selected-facets","completeness":"Complete","catalog_facets":19}}
