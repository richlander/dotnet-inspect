],"examples":["true"],"effects":["AcquisitionTier: package-content","Capability: package-content-provider"],"input-rules":[]},"requires":[]},"library-literal":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet34:package-query.term.library-literal28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/library-literal"}],"fact_states":{},"facts":{"identity":"package-query.term.library-literal","key":"library-literal","name":"library literal","summary":"Downloads the package and matches decoded string-literal uses across the selected implementation libraries.","operators":["eq"],"value-kind":"decoded UTF-16 text","values":[],"examples":["https://"],"effects":["AcquisitionTier: package-content","Capability: package-content-provider"],"input-rules":["Any decoded UTF-16 text within these constraints is accepted; the empty values list is not an allow list.","Length: 1..1024 UTF-16 code units.","Preserve all operand text, including whitespace, newlines, and case; do not normalize.","Match an ordinal substring of each decoded string-literal use.","Single distinct operand: identical repeated values collapse; distinct values are incompatible.","Queries using this facet admit at most five package candidates; an exact package ID admits at most one."]},"requires":["library-target"]},"library-target":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet33:package-query.term.library-target28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/library-target"}],"fact_states":{},"facts":{"identity":"package-query.term.library-target","key":"library-target","name":"library target","summary":"Records the exact target framework used to select the implementation libraries.","operators":["eq"],"value-kind":"NuGet target framework","values":[],"examples":["net10.0"],"effects":["AcquisitionTier: package-content","Capability: package-content-provider"],"input-rules":[]},"requires":[]}},"facet_order":["package","prefix","ecosystem","prerelease","dependencies","dependency-target","depends","depends-ecosystem","depends-transitive","dependency-depth","license","downloads","readme","tool","tool-format","references","skill","library-literal","library-target"],"bindings":{"dotnet-inspect.cli/package-query":{"identity":{"owner":"consumer","schema":"installed","type":"consumer-binding","value":"15:ConsumerBinding32:dotnet-inspect.cli/package-query-1:"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/bindings/cli"}],"fact_states":{},"facts":{"identity":"dotnet-inspect.cli/package-query","name":"dotnet-inspect CLI","summary":"A production Cli binding for \u0027Package Query\u0027.","consumer-kind":"Cli","gesture":"package query","input-rules":["Supply a package ID or PREFIX* as the positional argument after package query.","Supply exposed inspection facets through --where key=value.","Set the package-candidate work bound through --take N; -n N selects final result rows and does not replace that bound for inspection predicates.","Use --json for structured query result output.","Supply library-target through --tfm TFM, not --where. Use one exact NuGet target framework.","library-literal and --tfm require each other; neither is valid alone."],"members":"14"},"exposed_facets":["dependencies","dependency-target","depends","depends-ecosystem","depends-transitive","dependency-depth","license","downloads","readme","tool","tool-format","references","skill","library-literal"]}}}
