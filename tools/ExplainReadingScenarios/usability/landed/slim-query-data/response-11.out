{"format_version":1,"selection":{"kind":"query-facets","completeness":"Complete"},"identity":{"owner":"query-space","schema":"installed","type":"query-space","value":"10:QuerySpace28:package-query/query-space/v1-1:"},"path":"package-query/query","facts":{"identity":"package-query/query-space/v1","name":"package-query","summary":"The effective executable Query Space for this route.","members":"19"},"fact_states":{},"facets":{"package":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet26:package-query.term.package28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/package"}],"fact_states":{},"facts":{"identity":"package-query.term.package","key":"package","name":"exact package","summary":"Selects one exact package ID.","operators":["eq"],"value-kind":"NuGet package ID","values":[],"examples":["Newtonsoft.Json"],"effects":["AcquisitionTier: search-metadata"],"input-rules":[]},"requires":[]},"prefix":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet25:package-query.term.prefix28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/prefix"}],"fact_states":{},"facts":{"identity":"package-query.term.prefix","key":"prefix","name":"package prefix","summary":"Selects package IDs beginning with one literal prefix.","operators":["eq"],"value-kind":"NuGet package ID prefix","values":[],"examples":["Microsoft.Extensions."],"effects":["AcquisitionTier: search-metadata"],"input-rules":[]},"requires":[]},"ecosystem":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet28:package-query.term.ecosystem28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/ecosystem"}],"fact_states":{},"facts":{"identity":"package-query.term.ecosystem","key":"ecosystem","name":"ecosystem","summary":"Selects an ecosystem\u0027s core packages and every package under its recorded package-ID prefixes.","operators":["eq"],"value-kind":"canonical ecosystem ID","values":[],"examples":["ecosystem.aspire"],"effects":["AcquisitionTier: search-metadata"],"input-rules":[]},"requires":[]},"prerelease":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet29:package-query.term.prerelease28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/prerelease"}],"fact_states":{},"facts":{"identity":"package-query.term.prerelease","key":"prerelease","name":"package versions","summary":"Selects stable versions or includes prerelease versions.","operators":["eq"],"value-kind":"closed value","values":["stable","include"],"examples":["include"],"effects":["AcquisitionTier: search-metadata"],"input-rules":[]},"requires":[]},"dependencies":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet31:package-query.term.dependencies28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/dependencies"}],"fact_states":{},"facts":{"identity":"package-query.term.dependencies","key":"dependencies","name":"dependencies","summary":"Matches dependency absence or package-ID boundary in the selected scope.","operators":["eq"],"value-kind":"closed value","values":["none","cross-prefix"],"examples":["none"],"effects":["AcquisitionTier: nuspec"],"input-rules":[]},"requires":[]},"dependency-target":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet36:package-query.term.dependency-target28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/dependency-target"}],"fact_states":{},"facts":{"identity":"package-query.term.dependency-target","key":"dependency-target","name":"dependency target","summary":"Scopes dependency terms to all manifest groups or one TFM-selected group.","operators":["eq"],"value-kind":"all or NuGet target framework","values":[],"examples":["net8.0"],"effects":["AcquisitionTier: nuspec"],"input-rules":["Requires at least one depends, depends-transitive, depends-ecosystem, or dependencies term; applies to all dependency predicates in the query.","Dependency traversal requires an explicit dependency-target=\u003Ctfm\u003E; all is not accepted with dependency-depth or depends-transitive."]},"requires":[]},"depends":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet26:package-query.term.depends28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/depends"}],"fact_states":{},"facts":{"identity":"package-query.term.depends","key":"depends","name":"depends on package","summary":"Matches a direct dependency, or exact package reachability through dependency-depth.","operators":["eq","starts-with"],"value-kind":"NuGet package ID or prefix","values":[],"examples":["Microsoft.Extensions.DependencyInjection"],"effects":["AcquisitionTier: nuspec"],"input-rules":["Without dependency-depth, eq matches direct dependencies and starts-with matches direct package-ID prefixes. With dependency-depth=2, 3, or 4, eq matches direct or transitive declaration paths through that maximum; starts-with remains direct. A starts-with predicate alone cannot admit depth.","With dependency-depth, supply an explicit dependency-target=\u003Ctfm\u003E, not all, and admit at most 5 package candidates; an exact package input admits one. Repeated exact terms AND and share traversal."]},"requires":[]},"depends-ecosystem":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet36:package-query.term.depends-ecosystem28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/depends-ecosystem"}],"fact_states":{},"facts":{"identity":"package-query.term.depends-ecosystem","key":"depends-ecosystem","name":"depends on ecosystem","summary":"Matches a direct dependency in a registered ecosystem package population.","operators":["eq"],"value-kind":"canonical ecosystem ID","values":[],"examples":["ecosystem.aspire"],"effects":["AcquisitionTier: nuspec"],"input-rules":[]},"requires":[]},"depends-transitive":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet37:package-query.term.depends-transitive28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/depends-transitive"}],"fact_states":{},"facts":{"identity":"package-query.term.depends-transitive","key":"depends-transitive","name":"transitively depends on package","summary":"Legacy spelling for source-authorized dependency reachability at depth 2 or greater.","operators":["eq"],"value-kind":"NuGet package ID","values":[],"examples":["Microsoft.Extensions.Primitives"],"effects":["AcquisitionTier: nuspec"],"input-rules":["Requires an explicit dependency-target=\u003Ctfm\u003E and dependency-depth=2, 3, or 4; all is not accepted as the target.","Matches declaration edges at depth 2 through the selected maximum depth; direct-only dependencies do not match. Repeated terms AND and share traversal.","Admits at most 5 package candidates; an exact package input admits one. Set the candidate bound explicitly for a prefix or ecosystem population."]},"requires":["dependency-target","dependency-depth"]},"dependency-depth":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet35:package-query.term.dependency-depth28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/dependency-depth"}],"fact_states":{},"facts":{"identity":"package-query.term.dependency-depth","key":"dependency-depth","name":"dependency depth","summary":"Extends exact depends terms through the selected maximum declaration-edge depth.","operators":["eq"],"value-kind":"closed value","values":["2","3","4"],"examples":["2"],"effects":["AcquisitionTier: nuspec"],"input-rules":["Requires an explicit dependency-target=\u003Ctfm\u003E and at least one exact depends (eq) or legacy depends-transitive term. A starts-with predicate alone cannot satisfy this requirement; all is not accepted as the target.","Selects the maximum declaration-edge depth, not the result row limit. Prefer exact depends plus depth for new queries; depends-transitive remains the depth-2-or-greater legacy spelling.","Admits at most 5 package candidates; an exact package input admits one. Set the candidate bound explicitly for a prefix or ecosystem population."]},"requires":["dependency-target"]},"license":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet26:package-query.term.license28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/license"}],"fact_states":{},"facts":{"identity":"package-query.term.license","key":"license","name":"license","summary":"Matches license presence or a closed license identity derived from nuspec metadata.","operators":["eq"],"value-kind":"closed value","values":["any","MIT","OSMF"],"examples":["MIT"],"effects":["AcquisitionTier: nuspec"],"input-rules":[]},"requires":[]},"downloads":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet28:package-query.term.downloads28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/downloads"}],"fact_states":{},"facts":{"identity":"package-query.term.downloads","key":"downloads","name":"downloads","summary":"Matches a closed lifetime-download threshold reported by the package source.","operators":["eq"],"value-kind":"closed value","values":["10k","100k","1m"],"examples":["100k"],"effects":["AcquisitionTier: search-metadata"],"input-rules":[]},"requires":[]},"readme":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet25:package-query.term.readme28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/readme"}],"fact_states":{},"facts":{"identity":"package-query.term.readme","key":"readme","name":"embedded README","summary":"Matches a package manifest that declares an embedded README.","operators":["eq"],"value-kind":"boolean","values":["true"],"examples":["true"],"effects":["AcquisitionTier: nuspec"],"input-rules":[]},"requires":[]},"tool":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"10:QueryFacet23:package-query.term.tool28:package-query/query-space/v1"},"addresses":[{"owner":"resource-explanation","schema":"installed","kind":"resource-path","value":"package-query/query/facets/tool"}],"fact_states":{},"facts":{"identity":"package-query.term.tool","key":"tool","name":".NET Tool","summary":"Matches the .NET tool package type from the package manifest.","operators":["eq"],"value-kind":"boolean","values":["true"],"examples":["true"],"effects":["AcquisitionTier: nuspec"],"input-rules":[]},"requires":[]},"tool-format":{"identity":{"owner":"query-space","schema":"installed","type":"query-facet","value":"