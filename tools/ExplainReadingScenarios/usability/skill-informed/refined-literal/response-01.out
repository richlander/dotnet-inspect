ences assembly","type":"application/hal\u002Bjson"},"bindings":[{"href":"inspect-resource:/package-query/bindings/cli","title":"dotnet-inspect CLI","type":"application/json"}]},"key":"references","operators":["eq"],"value_kind":"assembly simple name","examples":["Microsoft.Extensions.DependencyInjection.Abstractions"],"effects":["AcquisitionTier: package-content","Capability: package-content-provider"],"input_rules":[],"values":[],"id":"package-query.term.references","requires":[]},{"kind":"query-facet","name":"embedded SKILL.md","summary":"Downloads the package and matches a skills/SKILL.md or skills/**/SKILL.md file.","_links":{"self":{"href":"inspect-resource:/package-query/query/facets/skill?projection=hal","title":"embedded SKILL.md","type":"application/hal\u002Bjson"},"bindings":[{"href":"inspect-resource:/package-query/bindings/cli","title":"dotnet-inspect CLI","type":"application/json"}]},"key":"skill","operators":["eq"],"value_kind":"boolean","examples":["true"],"effects":["AcquisitionTier: package-content","Capability: package-content-provider"],"input_rules":[],"values":["true"],"id":"package-query.term.skill","requires":[]},{"kind":"query-facet","name":"library literal","summary":"Downloads the package and matches decoded string-literal uses across the selected implementation libraries.","_links":{"self":{"href":"inspect-resource:/package-query/query/facets/library-literal?projection=hal","title":"library literal","type":"application/hal\u002Bjson"},"required-context":[{"href":"inspect-resource:/package-query/query/facets/library-target?projection=hal","title":"library target","type":"application/hal\u002Bjson"}],"bindings":[{"href":"inspect-resource:/package-query/bindings/cli","title":"dotnet-inspect CLI","type":"application/json"}]},"key":"library-literal","operators":["eq"],"value_kind":"decoded UTF-16 text","examples":["https://"],"effects":["AcquisitionTier: package-content","Capability: package-content-provider"],"input_rules":["Any decoded UTF-16 text within these constraints is accepted; the empty values list is not an allow list.","Length: 1..1024 UTF-16 code units.","Preserve all operand text, including whitespace, newlines, and case; do not normalize.","Match an ordinal substring of each decoded string-literal use.","Single distinct operand: identical repeated values collapse; distinct values are incompatible.","Queries using this facet admit at most five package candidates; an exact package ID admits at most one."],"values":[],"id":"package-query.term.library-literal","requires":["library-target"]},{"kind":"query-facet","name":"library target","summary":"Records the exact target framework used to select the implementation libraries.","_links":{"self":{"href":"inspect-resource:/package-query/query/facets/library-target?projection=hal","title":"library target","type":"application/hal\u002Bjson"}},"key":"library-target","operators":["eq"],"value_kind":"NuGet target framework","examples":["net10.0"],"effects":["AcquisitionTier: package-content","Capability: package-content-provider"],"input_rules":[],"values":[],"id":"package-query.term.library-target","requires":[]}],"bindings":[{"kind":"consumer-binding","name":"dotnet-inspect CLI","summary":"A production Cli binding for \u0027Package Query\u0027.","_links":{"self":{"href":"inspect-resource:/package-query/bindings/cli","title":"dotnet-inspect CLI","type":"application/json"},"exposed-facets":[{"href":"inspect-resource:/package-query/query/facets/dependencies?projection=hal","title":"dependencies","type":"application/hal\u002Bjson"},{"href":"inspect-resource:/package-query/query/facets/dependency-target?projection=hal","title":"dependency target","type":"application/hal\u002Bjson"},{"href":"inspect-resource:/package-query/query/facets/depends?projection=hal","title":"depends on package","type":"application/hal\u002Bjson"},{"href":"inspect-resource:/package-query/query/facets/depends-ecosystem?projection=hal","title":"depends on ecosystem","type":"applicati