,"_links":{"self":{"href":"inspect-resource:/package-query/query/facets/depends?projection=hal","title":"depends on package","type":"application/hal\u002Bjson"},"bindings":[{"href":"inspect-resource:/package-query/bindings/cli","title":"dotnet-inspect CLI","type":"application/json"}]},"key":"depends","operators":["eq","starts-with"],"value_kind":"NuGet package ID or prefix","examples":["Microsoft.Extensions.DependencyInjection"],"effects":["AcquisitionTier: nuspec"],"input_rules":[],"values":[],"id":"package-query.term.depends","requires":[]},{"kind":"query-facet","name":"depends on ecosystem","summary":"Matches a direct dependency in a registered ecosystem package population.","_links":{"self":{"href":"inspect-resource:/package-query/query/facets/depends-ecosystem?projection=hal","title":"depends on ecosystem","type":"application/hal\u002Bjson"},"bindings":[{"href":"inspect-resource:/package-query/bindings/cli","title":"dotnet-inspect CLI","type":"application/json"}]},"key":"depends-ecosystem","operators":["eq"],"value_kind":"canonical ecosystem ID","examples":["ecosystem.aspire"],"effects":["AcquisitionTier: nuspec"],"input_rules":[],"values":[],"id":"package-query.term.depends-ecosystem","requires":[]},{"kind":"query-facet","name":"transitively depends on package","summary":"Matches a source-authorized declared dependency reached at depth 2 or greater.","_links":{"self":{"href":"inspect-resource:/package-query/query/facets/depends-transitive?projection=hal","title":"transitively depends on package","type":"application/hal\u002Bjson"},"bindings":[{"href":"inspect-resource:/package-query/bindings/cli","title":"dotnet-inspect CLI","type":"application/json"}]},"key":"depends-transitive","operators":["eq"],"value_kind":"NuGet package ID","examples":["Microsoft.Extensions.Primitives"],"effects":["AcquisitionTier: nuspec"],"input_rules":[],"values":[],"id":"package-query.term.depends-transitive","requires":[]},{"kind":"query-facet","name":"dependency depth","summary":"B