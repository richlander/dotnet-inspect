{
  "command": "package query",
  "sections": [
    {
      "section": "Packages",
      "query_section": "Query: Packages",
      "summary": "Use package query with repeated --where terms. Terms are ANDed; repeated tool-format values are ORed. depends=\u003Cpackage ID\u003E matches a direct declared dependency, or reachability within dependency-depth=2|3|4 when paired with an exact dependency-target=\u003CTFM\u003E; depends starts-with \u003Cpackage ID prefix\u003E matches a direct declared dependency by literal prefix; depends-transitive=\u003Cpackage ID\u003E is the legacy depth-2-or-greater spelling; dependencies=cross-prefix matches a dependency from another first ID segment; depends-ecosystem=\u003Cecosystem ID\u003E matches a registered package population; dependency-target=all|\u003CTFM\u003E selects its manifest-group scope. ecosystem=\u003Cecosystem ID\u003E (or --ecosystem) replaces the package argument with an Ecosystem\u0027s core packages and recorded prefixes. --take bounds package candidates; -n and --rows select final matching package rows. A lone Head is pushed into execution when no explicit --take is present. Selecting a nuspec-expensive term evaluates at most 5 candidates. Selecting a metadata-expensive term evaluates at most 5 candidates and requires --tfm. Selecting a package-content term authorizes at most 20 candidates; --nuspec-only rejects those terms. Ordering and --top are not supported.",
      "facet_count": 14,
      "operators": [
        "--where"
      ],
      "facets": [
        {
          "name": "dependencies",
          "operators": [
            "--where"
          ],
          "comparisons": [
            "="
          ],
          "value_kind": "closed value",
          "values": [
            "none",
            "cross-prefix"
          ],
          "example": "--where \u0022dependencies=none\u0022",
          "execution_class": "nuspec",
          "resource_path": "package-query/query/facets/dependencies"
        },
        {
          "name": "dependency-target",
          "operators": [
            "--where"
          ],
          "comparisons": [
            "="
          ],
          "value_kind": "all or NuGet target framework",
          "values": [],
          "example": "--where \u0022dependency-target=net8.0\u0022",
          "execution_class": "nuspec",
          "resource_path": "package-query/query/facets/dependency-target"
        },
        {
          "name": "depends",
          "operators": [
            "--where"
          ],
          "comparisons": [
            "=",
            "starts-with"
          ],
          "value_kind": "NuGet package ID or prefix",
          "values": [],
          "example": "--where \u0022depends=Microsoft.Extensions.DependencyInjection\u0022",
          "execution_class": "nuspec",
          "resource_path": "package-query/query/facets/depends"
