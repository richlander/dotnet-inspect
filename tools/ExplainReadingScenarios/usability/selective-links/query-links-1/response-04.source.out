{"kind":"query-facet","name":"library literal","summary":"Downloads the package and matches decoded string-literal uses across the selected implementation libraries.","_links":{"self":{"href":"inspect-resource:/package-query/query/facets/library-literal?projection=hal","title":"library literal","type":"application/hal\u002Bjson"},"describedby":{"href":"inspect-resource:/package-query/query/facets/library-literal?projection=contract","title":"Explanation schema for client development","type":"application/json"},"required-context":[{"href":"inspect-resource:/package-query/query/facets/library-target?projection=hal","title":"library target","type":"application/hal\u002Bjson"}],"bindings":[{"href":"inspect-resource:/package-query/bindings/cli","title":"dotnet-inspect CLI","type":"application/json"}]},"key":"library-literal","operators":["eq"],"value_kind":"decoded UTF-16 text","examples":["https://"],"effects":["AcquisitionTier: package-content","Capability: package-content-provider"],"input_rules":["Any decoded UTF-16 text within these constraints is accepted; the empty values list is not an allow list.","Length: 1..1024 UTF-16 code units.","Preserve all operand text, including whitespace, newlines, and case; do not normalize.","Match an ordinal substring of each decoded string-literal use.","Single distinct operand: identical repeated values collapse; distinct values are incompatible.","Queries using this facet admit at most five package candidates; an exact package ID admits at most one."],"values":[],"id":"package-query.term.library-literal","requires":["library-target"],"data_scope":{"completeness":"Complete"},"_embedded":{"facets":[{"kind":"query-facet","name":"library target","summary":"Records the exact target framework used to select the implementation libraries.","_links":{"self":{"href":"inspect-resource:/package-query/query/facets/library-target?projection=hal","title":"library target","type":"application/hal\u002Bjson"}},"key":"library-target","operators":["eq"],"value_kind":"NuGet target framework","examples":["net10.0"],"effects":["AcquisitionTier: package-content","Capability: package-content-provider"],"input_rules":[],"values":[],"id":"package-query.term.library-target","requires":[]}],"bindings":[{"kind":"consumer-binding","name":"dotnet-inspect CLI","summary":"A production Cli binding for \u0027Package Query\u0027.","_links":{"self":{"href":"inspect-resource:/package-query/bindings/cli","title":"dotnet-inspect CLI","type":"application/json"},"exposed-facets":[{"href":"inspect-resource:/package-query/query/facets/library-literal?projection=hal","title":"library literal","type":"application/hal\u002Bjson"}]},"consumer_kind":"Cli","gesture":"package query","input_rules":["Supply a package ID or PREFIX* as the positional argument after package query.","Supply exposed inspection facets through --where key=value.","Set the package-candidate work bound through --take N; -n N selects final result rows and does not replace that bound for inspection predicates.","Use --json for structured query result output.","Supply library-target through --tfm TFM, not --where. Use one exact NuGet target framework.","library-literal and --tfm require each other; neither is valid alone."],"members":"14","id":"dotnet-inspect.cli/package-query","exposed_facets":["library-literal"]}]}}
