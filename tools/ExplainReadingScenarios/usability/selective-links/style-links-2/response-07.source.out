{"kind":"value-vocabulary","name":"C# Style Tiers","summary":"Fidelity and presentation tiers used to group C# style choices.","_links":{"self":{"href":"inspect-resource:/vocabularies/csharp.style-tiers?projection=hal","title":"C# Style Tiers","type":"application/hal\u002Bjson"},"describedby":{"href":"inspect-resource:/vocabularies/csharp.style-tiers?projection=contract","title":"Explanation schema for client development","type":"application/json"}},"members":"4","accepted_by":["decompiler.style-picker"],"maps":[{"identity":"order","name":"Order","summary":"Product-owned presentation order.","value-kind":"integer","target-vocabulary":null,"cardinality":"exactly-one","coverage":"complete"},{"identity":"byte_divergent","name":"Byte Divergent","summary":"Whether every choice in the tier may change emitted IL bytes.","value-kind":"boolean","target-vocabulary":null,"cardinality":"exactly-one","coverage":"complete"}],"defaults":[],"id":"csharp.style-tiers","property_sets":{"byte_divergent":["Lens"]},"property_groups":{},"_embedded":{"values":[{"kind":"vocabulary-value","name":"Formatting","summary":"Layout only \u2014 whitespace and line breaks. The code itself is unchanged, and compiles to identical IL.","_links":{"self":{"href":"inspect-resource:/vocabularies/csharp.style-tiers/values/formatting","title":"Formatting","type":"application/json"}},"id":"Formatting","order":"1"},{"kind":"vocabulary-value","name":"Spelling","summary":"An equally faithful way to spell the same code, such as qualifying a member with this or writing var. Compiles to identical IL.","_links":{"self":{"href":"inspect-resource:/vocabularies/csharp.style-tiers/values/spelling","title":"Spelling","type":"application/json"}},"id":"Spelling","order":"2"},{"kind":"vocabulary-value","name":"Local naming","summary":"Readable or approximate display names for locals. Compiles to identical IL, but the selected names may not represent exact source identity.","_links":{"self":{"href":"inspect-resource:/vocabularies/csharp.style-tiers/values/synthesis","title":"Local naming","type":"application/json"}},"id":"Synthesis","order":"3"},{"kind":"vocabulary-value","name":"Style lenses","summary":"Keeps what the code does, but not the exact bytes: this rendering recompiles to different IL than the shipped output, so it is excluded from byte-level fidelity checking.","_links":{"self":{"href":"inspect-resource:/vocabularies/csharp.style-tiers/values/lens","title":"Style lenses","type":"application/json"}},"id":"Lens","order":"4"}],"vocabularies":[]},"data_scope":{"completeness":"Complete"}}
