{"kind":"query-facet","name":"depends on package","summary":"Matches a direct dependency, or exact package reachability through dependency-depth.","_links":{"self":{"href":"inspect-resource:/package-query/query/facets/depends?projection=hal","title":"depends on package","type":"application/hal\u002Bjson"},"describedby":{"href":"inspect-resource:/package-query/query/facets/depends?projection=contract","title":"Explanation schema for client development","type":"application/json"},"bindings":[{"href":"inspect-resource:/package-query/bindings/cli","title":"dotnet-inspect CLI","type":"application/json"}]},"key":"depends","operators":["eq","starts-with"],"value_kind":"NuGet package ID or prefix","examples":["Microsoft.Extensions.DependencyInjection"],"effects":["AcquisitionTier: nuspec"],"input_rules":["Without dependency-depth, eq matches direct dependencies and starts-with matches direct package-ID prefixes. With dependency-depth=2, 3, or 4, eq matches direct or transitive declaration paths through that maximum; starts-with remains direct. A starts-with predicate alone cannot admit depth.","With dependency-depth, supply an explicit dependency-target=\u003Ctfm\u003E, not all, and admit at most 5 package candidates; an exact package input admits one. Repeated exact terms AND and share traversal."],"values":[],"id":"package-query.term.depends","requires":[],"data_scope":{"completeness":"Complete"},"_embedded":{"facets":[],"bindings":[{"kind":"consumer-binding","name":"dotnet-inspect CLI","summary":"A production Cli binding for \u0027Package Query\u0027.","_links":{"self":{"href":"inspect-resource:/package-query/bindings/cli","title":"dotnet-inspect CLI","type":"application/json"},"exposed-facets":[{"href":"inspect-resource:/package-query/query/facets/depends?projection=hal","title":"depends on package","type":"application/hal\u002Bjson"}]},"consumer_kind":"Cli","gesture":"package query","input_rules":["Supply a package ID or PREFIX* as the positional argument after package query.","Supply exposed inspection facets through --where key=value.","Set the package-candidate work bound through --take N; -n N selects final result rows and does not replace that bound for inspection predicates.","Use --json for structured query result output.","Supply library-target through --tfm TFM, not --where. Use one exact NuGet target framework.","library-literal and --tfm require each other; neither is valid alone."],"members":"14","id":"dotnet-inspect.cli/package-query","exposed_facets":["depends"]}]}}
