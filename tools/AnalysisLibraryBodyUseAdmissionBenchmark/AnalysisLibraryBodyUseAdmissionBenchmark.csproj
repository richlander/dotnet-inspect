<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <AssemblyName>analysis-library-body-use-admission-benchmark</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <PublishAot>true</PublishAot>
    <IsPublishable>true</IsPublishable>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageDownload Include="Jurassic" Version="[3.2.9]" />
    <PackageDownload Include="MessagePack" Version="[2.5.192]" />
    <PackageDownload Include="System.Text.Json" Version="[10.0.0]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)jurassic/3.2.9/lib/netstandard2.0/Jurassic.dll"
          Link="assets/Jurassic.3.2.9.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)messagepack/2.5.192/lib/net6.0/MessagePack.dll"
          Link="assets/MessagePack.2.5.192.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)system.text.json/10.0.0/lib/net10.0/System.Text.Json.dll"
          Link="assets/System.Text.Json.10.0.0.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ILInspector.Analysis/ILInspector.Analysis.csproj" />
  </ItemGroup>

</Project>
