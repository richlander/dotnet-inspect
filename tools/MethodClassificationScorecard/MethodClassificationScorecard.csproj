<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The method classification enablement's performance scorecard (#8773):
    the QuerySpaceScorecard shape with Old (the dated legacy scanner) and
    Direct PEReader and production request-set Planner columns beside LINQ and
    NLinq, over the public async and P/Invoke method populations. It also emits
    independent/collapsed request-set work and allocation evidence. Publish
    NativeAOT to time:
      dotnet publish tools/MethodClassificationScorecard -c Release -r <rid> -p:PublishAot=true -p:IsPublishable=true -o <dir>
    See docs/evidence-and-validation.md#performance-oracles-for-queryspace-enablement.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <AssemblyName>method-classification-scorecard</AssemblyName>
    <RootNamespace>MethodClassificationScorecard</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tests\DotnetInspector.PerformanceOracles\DotnetInspector.PerformanceOracles.csproj" />
    <ProjectReference Include="..\..\tests\ILInspector.Metadata.LegacyOracles\ILInspector.Metadata.LegacyOracles.csproj" />
    <ProjectReference Include="..\..\src\DotnetInspector.Queries\DotnetInspector.Queries.csproj" />
  </ItemGroup>

</Project>
