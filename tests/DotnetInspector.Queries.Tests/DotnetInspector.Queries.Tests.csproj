<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsAotCompatible>false</IsAotCompatible>
    <OutputType>Exe</OutputType>
    <SourceLink>$(MSBuildProjectDirectory)/sourcelink.json</SourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageDownload Include="Microsoft.NETCore.App.Ref"
                     Version="[11.0.0-preview.7.26381.103]" />
    <PackageDownload Include="System.Memory.Data"
                     Version="[11.0.0-preview.7.26381.103]" />
    <PackageDownload Include="System.Text.Encodings.Web"
                     Version="[11.0.0-preview.7.26381.103]" />
    <PackageDownload Include="System.Text.Json"
                     Version="[11.0.0-preview.7.26381.103]" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotnetInspector.PackageQueries\DotnetInspector.PackageQueries.csproj" />
    <ProjectReference Include="..\..\src\DotnetInspector.Queries\DotnetInspector.Queries.csproj" />
    <ProjectReference Include="..\DotnetInspector.Queries.Consumer\DotnetInspector.Queries.Consumer.csproj" />
    <ProjectReference Include="..\..\fixtures\queries\DotnetInspector.Queries.EmbeddedFixtures\DotnetInspector.Queries.EmbeddedFixtures.csproj" />
    <ProjectReference Include="..\..\src\DotnetInspector.ResearchQueries\DotnetInspector.ResearchQueries.csproj" />
    <ProjectReference Include="..\..\fixtures\analysis\ILInspector.Analysis.Fixtures\ILInspector.Analysis.Fixtures.csproj" />
    <ProjectReference Include="..\..\fixtures\analysis\ILInspector.Analysis.CallerGraphCaller\ILInspector.Analysis.CallerGraphCaller.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\analysis\ILInspector.Analysis.CallerGraphTarget\ILInspector.Analysis.CallerGraphTarget.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\analysis\ILInspector.Analysis.CallerGraphTargetV2\ILInspector.Analysis.CallerGraphTargetV2.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\analysis\ILInspector.Analysis.OwnershipFlowFixtures\ILInspector.Analysis.OwnershipFlowFixtures.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\diff\DiffFixtures.V1\DiffFixtures.V1.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\diff\DiffFixtures.V2\DiffFixtures.V2.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\queries\DotnetInspector.SourceDiff.V1\DotnetInspector.SourceDiff.V1.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\queries\DotnetInspector.SourceDiff.V2\DotnetInspector.SourceDiff.V2.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\queries\DotnetInspector.RestoredProjectFixtures\DotnetInspector.RestoredProjectFixtures.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\ILInspector.CallGraph\ILInspector.CallGraph.csproj" />
    <ProjectReference Include="..\..\src\ILInspector.ILDiff\ILInspector.ILDiff.csproj" />
    <ProjectReference Include="..\..\fixtures\shared\DotnetInspector.Fixtures\DotnetInspector.Fixtures.csproj" />
    <ProjectReference Include="..\DotnetInspector.FixtureInfrastructure\DotnetInspector.FixtureInfrastructure.csproj" />
    <ProjectReference Include="..\DotnetInspector.PackageManifestCorpus\DotnetInspector.PackageManifestCorpus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\eng\package-manifest-corpus.json"
                      LogicalName="DotnetInspector.Queries.Tests.PackageManifestCorpus.json" />
    <EmbeddedResource Include="..\..\eng\view-facet-compatibility.json"
                      LogicalName="DotnetInspector.Queries.Tests.ViewFacetCompatibility.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)system.memory.data/11.0.0-preview.7.26381.103/lib/net10.0/System.Memory.Data.dll"
          Link="RealAssets/BindingComposition/package/System.Memory.Data.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)system.text.json/11.0.0-preview.7.26381.103/lib/net10.0/System.Text.Json.dll"
          Link="RealAssets/BindingComposition/package/System.Text.Json.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)system.text.encodings.web/11.0.0-preview.7.26381.103/lib/net10.0/System.Text.Encodings.Web.dll"
          Link="RealAssets/BindingComposition/package/System.Text.Encodings.Web.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.netcore.app.ref/11.0.0-preview.7.26381.103/ref/net11.0/System.Text.Json.dll"
          Link="RealAssets/BindingComposition/platform/System.Text.Json.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.netcore.app.ref/11.0.0-preview.7.26381.103/ref/net11.0/System.Text.Encodings.Web.dll"
          Link="RealAssets/BindingComposition/platform/System.Text.Encodings.Web.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
