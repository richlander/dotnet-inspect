<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RootNamespace>DotnetInspector.DocumentationHouse.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageDownload Include="System.Text.Json"
                     Version="[10.0.0]" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/DotnetInspector.DocumentationHouse.Direct/DotnetInspector.DocumentationHouse.Direct.csproj" />
    <ProjectReference Include="../../src/DotnetInspector.DocumentationHouse.Source/DotnetInspector.DocumentationHouse.Source.csproj" />
    <ProjectReference Include="../../src/DotnetInspector.DocumentationHouse/DotnetInspector.DocumentationHouse.csproj" />
    <ProjectReference Include="../../src/DotnetInspector.LibraryMetadata/DotnetInspector.LibraryMetadata.csproj" />
    <ProjectReference Include="../../src/Inspector.Artifacts.Workspaces/Inspector.Artifacts.Workspaces.csproj" />
    <ProjectReference Include="../../tools/SourceBuildAttestation/SourceBuildAttestation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)system.text.json/10.0.0/lib/net10.0/System.Text.Json.dll"
          Link="RealAssets/DocumentationHouse/System.Text.Json.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)system.text.json/10.0.0/lib/net10.0/System.Text.Json.xml"
          Link="RealAssets/DocumentationHouse/System.Text.Json.xml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
