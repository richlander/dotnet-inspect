<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <!-- This assembly contains compiled runtime-async specimens for analysis tests. -->
    <Features>$(Features);runtime-async=on</Features>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageDownload Include="Jurassic" Version="[3.2.9]" />
    <PackageDownload Include="MessagePack" Version="[2.5.192]" />
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.linux-x64"
                     Version="[11.0.0-rc.1.26425.128]" />
    <PackageDownload Include="System.Text.Json" Version="[10.0.0]" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)jurassic/3.2.9/lib/netstandard2.0/Jurassic.dll"
          Link="RealAssets/AllocationLifetime/Jurassic.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)messagepack/2.5.192/lib/net6.0/MessagePack.dll"
          Link="RealAssets/ResourceTriage/MessagePack.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)system.text.json/10.0.0/lib/net10.0/System.Text.Json.dll"
          Link="PinnedArtifacts/packages/System.Text.Json.10.0.0.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.linux-x64/11.0.0-rc.1.26425.128/runtimes/linux-x64/lib/net11.0/System.Private.CoreLib.dll"
          Link="PinnedArtifacts/System.Private.CoreLib.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

