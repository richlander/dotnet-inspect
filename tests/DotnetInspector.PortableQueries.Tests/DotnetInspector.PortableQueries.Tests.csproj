<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RootNamespace>DotnetInspector.PortableQueries.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="QuerySpace" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/QuerySpace/QuerySpace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The design model is the gate; the codec is tested against it rather than
         against a copy that could drift. -->
    <EmbeddedResource Include="..\..\docs\design\models\portable-query-payload\vectors.json"
                      LogicalName="DotnetInspector.PortableQueries.Tests.PortableQueryPayloadVectors.json" />
  </ItemGroup>

</Project>
