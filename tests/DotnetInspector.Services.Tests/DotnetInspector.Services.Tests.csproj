<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <LangVersion>preview</LangVersion>
    <RootNamespace>DotnetInspector.Services.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageDownload Include="System.Text.Json"
                     Version="[10.0.0]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../fixtures/services/signatures/*.nupkg"
          Link="Fixtures/Signatures/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="DotnetInspector.Networking" />
    <Using Include="Xunit" />
    <Using Include="ILInspector.SourceLink" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotnetInspector.Cache\DotnetInspector.Cache.csproj" />
    <ProjectReference Include="..\..\src\DotnetInspector.DocumentationHouse\DotnetInspector.DocumentationHouse.csproj" />
    <ProjectReference Include="..\..\src\DotnetInspector.DocumentationHouse.Packages\DotnetInspector.DocumentationHouse.Packages.csproj" />
    <ProjectReference Include="..\..\src\DotnetInspector.LibraryMetadata\DotnetInspector.LibraryMetadata.csproj" />
    <ProjectReference Include="..\..\src\DotnetInspector.PackageQueries\DotnetInspector.PackageQueries.csproj" />
    <ProjectReference Include="..\..\src\DotnetInspector.Sections\DotnetInspector.Sections.csproj" />
    <ProjectReference Include="..\..\src\DotnetInspector.Services\DotnetInspector.Services.csproj" />
    <ProjectReference Include="..\..\src\DotnetInspector.Networking\DotnetInspector.Networking.csproj" />
    <ProjectReference Include="..\..\src\DotnetInspector.PackageHouse.Execution\DotnetInspector.PackageHouse.Execution.csproj" />
    <ProjectReference Include="..\..\src\ILInspector.SourceLink\ILInspector.SourceLink.csproj" />
    <ProjectReference Include="..\..\fixtures\services\DotnetInspector.Services.RouteLearning.Consumer\DotnetInspector.Services.RouteLearning.Consumer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\services\DotnetInspector.Services.RouteLearning.Unrelated\DotnetInspector.Services.RouteLearning.Unrelated.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\analysis\ILInspector.Analysis.CallerGraphCaller\ILInspector.Analysis.CallerGraphCaller.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\analysis\ILInspector.Analysis.CallerGraphTarget\ILInspector.Analysis.CallerGraphTarget.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DotnetInspector.FixtureInfrastructure\DotnetInspector.FixtureInfrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)system.text.json/10.0.0/lib/net10.0/System.Text.Json.dll"
          Link="RealAssets/PackageHouse/System.Text.Json.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)system.text.json/10.0.0/lib/net10.0/System.Text.Json.xml"
          Link="RealAssets/PackageHouse/System.Text.Json.xml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
