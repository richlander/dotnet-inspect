<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.linux-x64"
                     Version="[11.0.0-rc.1.26425.128]" />
    <PackageDownload Include="System.Text.Json" Version="[10.0.0]" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)system.text.json/10.0.0/lib/net10.0/System.Text.Json.dll"
          Link="PinnedArtifacts/packages/System.Text.Json.10.0.0.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.linux-x64/11.0.0-rc.1.26425.128/runtimes/linux-x64/lib/net11.0/System.Private.CoreLib.dll"
          Link="PinnedArtifacts/System.Private.CoreLib.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="ILInspector.SourceLink" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\fixtures\diff\DiffFixtures.V1\DiffFixtures.V1.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\diff\DiffFixtures.V2\DiffFixtures.V2.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\research\ILInspector.Research.TargetFixtures\ILInspector.Research.TargetFixtures.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\research\ILInspector.Research.NameFamilyFixtures\ILInspector.Research.NameFamilyFixtures.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\research\ResearchTargetCorrespondenceFixtures.V1\ResearchTargetCorrespondenceFixtures.V1.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\research\ResearchTargetCorrespondenceFixtures.V2\ResearchTargetCorrespondenceFixtures.V2.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\analysis\ILInspector.Analysis.Fixtures\ILInspector.Analysis.Fixtures.csproj" />
    <ProjectReference Include="..\..\fixtures\analysis\ILInspector.Analysis.CalleeResolutionFixtures\ILInspector.Analysis.CalleeResolutionFixtures.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\ILInspector.Decompiler\ILInspector.Decompiler.csproj" />
    <ProjectReference Include="..\..\src\ILInspector.ILDiff\ILInspector.ILDiff.csproj" />
    <ProjectReference Include="..\..\src\ILInspector.Metadata\ILInspector.Metadata.csproj" />
    <ProjectReference Include="..\..\src\ILInspector.Research\ILInspector.Research.csproj" />
    <ProjectReference Include="..\..\src\ILInspector.SourceLink\ILInspector.SourceLink.csproj" />
    <ProjectReference Include="..\..\src\Inspector.Artifacts\Inspector.Artifacts.csproj" />
    <ProjectReference Include="..\DotnetInspector.FixtureInfrastructure\DotnetInspector.FixtureInfrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\design\annotated-source-finding-provenance.md"
                      LogicalName="ILInspector.Research.Tests.AnnotatedSourceFindingProvenance.md" />
  </ItemGroup>

</Project>
