<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.linux-x64"
                     Version="[11.0.0-rc.1.26425.128]" />
    <PackageDownload Include="System.Net.Http.Json"
                     Version="[10.0.0]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.linux-x64\11.0.0-rc.1.26425.128\runtimes\linux-x64\lib\net11.0\System.Private.CoreLib.dll"
          Link="PinnedArtifacts\System.Private.CoreLib.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)system.net.http.json/10.0.0/lib/net10.0/System.Net.Http.Json.dll"
          Link="PinnedArtifacts\System.Net.Http.Json.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="ILInspector.SourceLink" />
    <AssemblyMetadata Include="D3FixtureProducerSdk" Value="$(NETCoreSdkVersion)" />
    <EmbeddedResource Include="Corpus/custom-attribute-d3.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotnetInspector.Cache\DotnetInspector.Cache.csproj" />
    <ProjectReference Include="../../src/NuGetFetch/NuGetFetch.csproj" />
    <ProjectReference Include="../DotnetInspector.FixtureInfrastructure/DotnetInspector.FixtureInfrastructure.csproj" />
    <ProjectReference Include="../../fixtures/metadata/ILInspector.Metadata.AttributeEnumFixtures/ILInspector.Metadata.AttributeEnumFixtures.csproj" />
    <ProjectReference Include="../../fixtures/metadata/ILInspector.Metadata.ApiDeclarationCorrespondence.V1/ILInspector.Metadata.ApiDeclarationCorrespondence.V1.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../fixtures/metadata/ILInspector.Metadata.ApiDeclarationCorrespondence.V2/ILInspector.Metadata.ApiDeclarationCorrespondence.V2.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/CSharpText/CSharpText.csproj" />
    <ProjectReference Include="../../src/ILInspector.Metadata/ILInspector.Metadata.csproj" />
    <ProjectReference Include="../../src/Inspector.Artifacts.Workspaces/Inspector.Artifacts.Workspaces.csproj" />
    <ProjectReference Include="../../src/ILInspector.SourceLink/ILInspector.SourceLink.csproj" />
    <ProjectReference Include="../../fixtures/queries/DotnetInspector.Queries.EmbeddedFixtures/DotnetInspector.Queries.EmbeddedFixtures.csproj" />
    <ProjectReference Include="../../fixtures/metadata/ILInspector.Metadata.StateMachineFixtures/ILInspector.Metadata.StateMachineFixtures.csproj" />
    <ProjectReference Include="../../fixtures/metadata/ILInspector.Metadata.SpellabilityConsumer/ILInspector.Metadata.SpellabilityConsumer.csproj" />
    <ProjectReference Include="../../fixtures/metadata/ILInspector.Metadata.SpellabilityReference/ILInspector.Metadata.SpellabilityReference.csproj" />
    <ProjectReference Include="../../fixtures/metadata/ILInspector.Metadata.TypeDependencyConsumer/ILInspector.Metadata.TypeDependencyConsumer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../fixtures/metadata/ILInspector.Metadata.MemorySafetyFixtures/ILInspector.Metadata.MemorySafetyFixtures.csproj" />
    <ProjectReference Include="../ILInspector.Metadata.ConsumerCanary/ILInspector.Metadata.ConsumerCanary.csproj" />
    <ProjectReference Include="../../fixtures/metadata/ILInspector.Metadata.MethodImplFixtures/ILInspector.Metadata.MethodImplFixtures.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../fixtures/metadata/ILInspector.Metadata.InterfaceImplContracts/ILInspector.Metadata.InterfaceImplContracts.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../fixtures/metadata/ILInspector.Metadata.InterfaceImplFixtures/ILInspector.Metadata.InterfaceImplFixtures.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../fixtures/metadata/ILInspector.Metadata.PublicMethodRootFixtures/ILInspector.Metadata.PublicMethodRootFixtures.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../fixtures/sourcelink/DotnetInspector.SourceLinkVisualBasicFixtures/DotnetInspector.SourceLinkVisualBasicFixtures.vbproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../fixtures/metadata/ILInspector.Metadata.ExtensionInstanceOld/ILInspector.Metadata.ExtensionInstanceOld.csproj">
      <Aliases>extensionold</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../fixtures/metadata/ILInspector.Metadata.ExtensionInstanceNew/ILInspector.Metadata.ExtensionInstanceNew.csproj">
      <Aliases>extensionnew</Aliases>
    </ProjectReference>
    <!-- New-rules unsafe fixture: a member declared `unsafe` with no pointer in
         its signature is stamped [RequiresUnsafeAttribute]; used to verify the
         API surface marks it unsafe. -->
    <ProjectReference Include="../../fixtures/decompiler/ILInspector.Decompiler.Fixtures.NewUnsafe/ILInspector.Decompiler.Fixtures.NewUnsafe.csproj" />
    <ProjectReference Include="../../fixtures/decompiler/ILInspector.Decompiler.Fixtures.LegacyUnsafe/ILInspector.Decompiler.Fixtures.LegacyUnsafe.csproj">
      <Aliases>legacyunsafe</Aliases>
    </ProjectReference>
    <!-- #1741 fixture: DiffAsmTarget exposes two overloads whose parameter types
         share the FQN Shared.Token but come from different assemblies (LibA vs
         LibB). Used to prove the structural signature keeps them distinct. -->
    <ProjectReference Include="../../fixtures/diff/DiffAsmFixtures.Target/DiffAsmFixtures.Target.csproj" />
  </ItemGroup>

</Project>
