<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AssemblyName>DotnetInspect.Cli.Tests</AssemblyName>
    <RootNamespace>DotnetInspect.Cli.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit.v3" />
    <PackageDownload Include="Npgsql.EntityFrameworkCore.PostgreSQL"
                     Version="[8.0.4]" />
    <PackageDownload Include="Microsoft.EntityFrameworkCore.Relational"
                     Version="[8.0.4]" />
    <PackageDownload Include="Avalonia" Version="[11.3.14];[12.1.2]" />
    <PackageDownload Include="DotWasm.Models" Version="[0.1.0]" />
    <PackageDownload Include="System.ValueTuple" Version="[4.5.0]" />
    <PackageDownload Include="Microsoft.AspNetCore.App" Version="[2.2.8]" />
    <PackageDownload Include="dotnet-outdated-tool" Version="[4.8.1]" />
    <PackageDownload Include="CrestApps.AgentSkills.Mcp.OrchardCore"
                     Version="[1.2.0]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)avalonia/11.3.14/avalonia.11.3.14.nupkg"
          Link="RealAssets/ApiMatching/avalonia.11.3.14.nupkg"
