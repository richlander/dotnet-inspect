# Every status is in the vocabulary, and incomplete obligations occur only on abstract classes or interfaces.
([.members[].source.status, .types[].source.status] | all(IN("complete", "no_method_body", "no_sequence_points", "no_pdb", "no_source_link", "unmapped_document", "forwarder", "offline", "not_requested", "failed"))) and ([.members[].documentation.status, .types[].documentation.status] | all(IN("complete", "no_documentation", "forwarder", "offline", "not_requested", "failed"))) and all(.types[]; .required_overrides_complete or .is_abstract or .definition_kind == "interface")
