<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>DotnetInspect.Web.Tests</AssemblyName>
    <RootNamespace>DotnetInspect.Web.Tests</RootNamespace>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit.v3" />
    <PackageDownload Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="[4.1.0]" />
    <PackageDownload Include="Microsoft.Azure.SignalR" Version="[1.33.1]" />
    <PackageDownload Include="System.Text.Json" Version="[10.0.0];[11.0.0-preview.7.26381.103]" />
    <PackageDownload Include="Microsoft.NETCore.App.Ref" Version="[10.0.10];[11.0.0-preview.7.26381.103]" />
    <PackageDownload Include="Microsoft.AspNetCore.App.Runtime.linux-x64" Version="[10.0.10]" />
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.linux-x64" Version="[10.0.10]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.linux-x64\10.0.10\runtimes\linux-x64\lib\net10.0\System.Runtime.dll;$(NuGetPackageRoot)microsoft.netcore.app.runtime.linux-x64\10.0.10\runtimes\linux-x64\lib\net10.0\System.Private.CoreLib.dll"
      Link="RealAssets\PlatformDemo\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.aspnetcore.app.runtime.linux-x64\10.0.10\runtimes\linux-x64\lib\net10.0\Microsoft.Extensions.DependencyInjection.Abstractions.dll;$(NuGetPackageRoot)microsoft.aspnetcore.app.runtime.linux-x64\10.0.10\runtimes\linux-x64\lib\net10.0\Microsoft.Extensions.Logging.dll;$(NuGetPackageRoot)microsoft.aspnetcore.app.runtime.linux-x64\10.0.10\runtimes\linux-x64\lib\net10.0\Microsoft.Extensions.Http.dll"
      Link="RealAssets\PlatformDemo\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)system.text.json\11.0.0-preview.7.26381.103\lib\net10.0\System.Text.Json.dll"
      Link="RealAssets\Spotlight\package\System.Text.Json.dll"
      CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)system.text.json\11.0.0-preview.7.26381.103\lib\netstandard2.0\System.Text.Json.dll"
      Link="RealAssets\TypeDependencies\System.Text.Json.dll"
      CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.netcore.app.ref\11.0.0-preview.7.26381.103\ref\net11.0\System.Text.Json.dll"
      Link="RealAssets\Spotlight\platform\System.Text.Json.dll"
      CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.netcore.app.ref\10.0.10\microsoft.netcore.app.ref.10.0.10.nupkg"
      Link="RealAssets\FrameworkActivation\microsoft.netcore.app.ref.10.0.10.nupkg"
      CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.linux-x64\10.0.10\microsoft.netcore.app.runtime.linux-x64.10.0.10.nupkg"
      Link="RealAssets\FrameworkActivation\microsoft.netcore.app.runtime.linux-x64.10.0.10.nupkg"
      CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)system.text.json\10.0.0\system.text.json.10.0.0.nupkg"
      Link="RealAssets\FrameworkActivation\system.text.json.10.0.0.nupkg"
      CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.fluentui.aspnetcore.components.icons\4.1.0\microsoft.fluentui.aspnetcore.components.icons.4.1.0.nupkg"
      Link="RealAssets\Documentation\microsoft.fluentui.aspnetcore.components.icons.4.1.0.nupkg"
      CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.azure.signalr\1.33.1\microsoft.azure.signalr.1.33.1.nupkg"
      Link="RealAssets\LibraryApiDiff\microsoft.azure.signalr.1.33.1.nupkg"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\DotnetInspect.Web.Core\DotnetInspect.Web.Core.csproj" />
    <ProjectReference Include="..\..\src\DotnetInspect.Web\DotnetInspect.Web.csproj" />
    <ProjectReference Include="..\..\src\DotnetInspector.Cache\DotnetInspector.Cache.csproj" />
    <ProjectReference Include="..\..\src\DotnetInspector.Platforms.Packages\DotnetInspector.Platforms.Packages.csproj" />
    <ProjectReference Include="..\..\src\UntrustedDocuments\UntrustedDocuments.csproj" />
    <ProjectReference Include="..\..\src\QuerySpace\QuerySpace.csproj" />
    <ProjectReference Include="..\..\fixtures\inspect-web\InspectWeb.CloneTransportFixtures\InspectWeb.CloneTransportFixtures.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\fixtures\inspect-web\InspectWeb.DocumentationFixtures\InspectWeb.DocumentationFixtures.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\fixtures\queries\DotnetInspector.CloneSearchFixtures\DotnetInspector.CloneSearchFixtures.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\fixtures\inspect-web\InspectWeb.MethodBodyFixtures\InspectWeb.MethodBodyFixtures.csproj" />
    <ProjectReference Include="..\..\fixtures\analysis\ILInspector.Analysis.Fixtures\ILInspector.Analysis.Fixtures.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\fixtures\analysis\ILInspector.Analysis.CallerGraphTarget\ILInspector.Analysis.CallerGraphTarget.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\fixtures\decompiler\ILInspector.Decompiler.Fixtures.NewUnsafe\ILInspector.Decompiler.Fixtures.NewUnsafe.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!--
      Both Source comparison fixtures publish the same InspectWebSourceComparisonFixture.dll file
      name, so they are build-ordering references only; the tests read them through FixtureCatalog.
    -->
    <ProjectReference Include="..\..\fixtures\inspect-web\InspectWeb.SourceComparisonFixtures.V1\InspectWeb.SourceComparisonFixtures.V1.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\inspect-web\InspectWeb.SourceComparisonFixtures.V2\InspectWeb.SourceComparisonFixtures.V2.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\presentation\LibraryApiDiff.V1\LibraryApiDiff.V1.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\fixtures\presentation\LibraryApiDiff.V2\LibraryApiDiff.V2.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\tests\DotnetInspector.FixtureInfrastructure\DotnetInspector.FixtureInfrastructure.csproj" />
  </ItemGroup>
</Project>
