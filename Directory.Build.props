<!-- Firewall: stop MSBuild upward traversal from picking up dotnet-inspect repo
     config when this branch is materialized at external/ILAssembler. -->
<Project>
  <PropertyGroup>
    <!-- NuGet discovers the repo's Directory.Packages.props via its own upward
         walk (Directory.Build.props stubs don't stop it). Opt out so this
         branch builds identically standalone and in-repo (avoids NU1008). -->
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
  </PropertyGroup>
</Project>
