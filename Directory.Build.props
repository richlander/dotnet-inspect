<Project>
  <PropertyGroup>
    <!--
      The official non-AOT "any" fallback package targets the LTS floor (net10.0) so
      it installs and runs on machines that only have the LTS runtime. Everything else
      (dev, test, and the RID-specific Native AOT packages) uses the latest runtime so
      daily development dogfoods it and surfaces runtime bugs early. The "any" package
      is the only managed-runtime artifact we ship, so it is the only one that needs the
      conservative floor. Keyed on OfficialBuild + non-AOT (rather than a CLI override)
      so an accidental `dotnet pack -r any` can't silently ship a net11.0 fallback. See
      issue #240.
    -->
    <DefaultTargetFramework Condition="'$(DefaultTargetFramework)' == '' and '$(OfficialBuild)' == 'true' and '$(PublishAot)' == 'false'">net10.0</DefaultTargetFramework>
    <DefaultTargetFramework Condition="'$(DefaultTargetFramework)' == ''">net$(NETCoreAppMaximumVersion)</DefaultTargetFramework>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Audit the full transitive package closure, not just direct references.
      The SDK derives NuGetAuditMode from the target framework: "all" at net10.0
      and above, "direct" below it. That made the audit posture a side effect of
      whichever framework a project happened to target rather than a repository
      decision. Two projects sat below the threshold and audited only their
      direct references: msdl-proxy, pinned to net8.0 because Azure Static Web
      Apps managed functions do not yet support .NET 10 (issue #5364), and
      ILInspector.Analysis.FacadeFixtures, which targets netstandard2.0 and
      resolves packages implicitly rather than by declared PackageReference.

      NuGetAuditLevel is stated for the same reason. "low" reports every
      severity, and leaving it unstated would let a future SDK default silently
      narrow what counts as reportable.

      Audit findings are NU1901-NU1904. Directory.Build.targets escalates those
      to errors directly rather than relying on TreatWarningsAsErrors above,
      because four fixture projects opt out of that default.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!--
      Only tools are packable or publishable, and those are project properties
      rather than consequences of whichever SDK command was run (issue #3330).
      Internal libraries have no versioning story, no API stability commitment,
      and no intent to be consumed externally; if one reached a feed at 1.0.0,
      the layering rules in AGENTS.md would become an external compatibility
      surface instead of an internal design constraint. Both surfaces are off
      by default. Tool projects explicitly opt into packing and use IsTool for
      their shared publish behavior.
    -->
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

</Project>
